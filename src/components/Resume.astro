---
const experiences = [
  {
    company: "Amazon",
    period: "2025 - Present",
    positions: [
      {
        title: "Applied Scientist L5",
        description: [
          "Designed and deployed multi-agent LLM framework converting natural language to executable code, improving functional success rates by 12%.",
          "Built real-time detection system correctly identifying 93% of unfeasible requests with 4.5x performance improvement.",
        ],
      },
    ],
  },
  {
    company: "FleetSmart.ai",
    period: "2025 - 2026",
    positions: [
      {
        title: "AI Engineer (B2B Contract)",
        description: [
          "Built AI-powered maritime decision engine with hybrid LLM + deterministic recommendation system, deployed on GCP Cloud Run.",
          "Developed scoring experiment harness across 4 architecture variants, KPI computation engine, and world news intelligence pipeline.",
        ],
      },
    ],
  },
  {
    company: "XPensAI",
    period: "2024 - 2026",
    positions: [
      {
        title: "Co-Founder & ML Engineer",
        description: [
          "Launched AI-powered SaaS platform used by 30+ businesses, reducing manual expense entry by 65%.",
          "Built deep learning solutions achieving 95% accuracy on receipt scanning.",
        ],
      },
    ],
  },
  {
    company: "University of Tennessee",
    period: "2021 - 2026",
    positions: [
      {
        title: "Machine Learning Researcher (PhD)",
        description: [
          "Published at NeurIPS 2023, WACV 2023, IEEE IGARSS 2024. 10 papers, 102+ citations.",
          "Developed self-supervised frameworks for remote sensing achieving state-of-the-art results.",
        ],
      },
    ],
  },
  {
    company: "Performance Technologies",
    period: "2019 - 2021",
    positions: [
      {
        title: "Data Engineer",
        description: [
          "Led terabyte-scale data replication reducing processing time from days to minutes.",
          "Developed ML model delivering 34% improvement over baseline.",
        ],
      },
    ],
  },
];

const avatarUrl = "/kostas_neurips_square.jpg";
---

<div>
  <div class="mx-auto max-w-6xl px-4">
    <div class="relative">
      <div class="divide-y divide-gray-100">
        {experiences.map((experience) => (
          <div class="grid grid-cols-[1fr,5fr] gap-6 py-12 first:pt-0 last:pb-0 md:grid-cols-[2fr,1fr,4fr]">
            <div class="hidden md:block">
              <h3 class="text-xl font-bold text-text-primary">{experience.company}</h3>
              <p class="text-sm text-gray-600">{experience.period}</p>
            </div>

            <div />

            <div class="space-y-6">
              {experience.positions.map((position) => (
                <div class="space-y-4">
                  <h4 class="text-lg font-semibold text-text-primary">{position.title}</h4>
                  <div class="space-y-3">
                    {position.description.map((desc) => (
                      <p class="text-gray-600">{desc}</p>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Timeline spine (slot for React island) -->
      <div class="absolute top-0 h-full w-8 md:left-[calc(28%_-_1rem)]">
        <slot name="timeline" />
      </div>
    </div>
  </div>
</div>
