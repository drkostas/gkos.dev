---
/**
 * Section header pattern used across the site:
 *   <eyebrow> (small, uppercase, purple-primary, tracking-widest)
 *   <title>   (h2, larger, sentence-case)
 *   <subtitle?> (optional one-line description)
 *
 * Matches the eyebrow + title pattern used on /about, /projects, /publications,
 * and the home page sections. Centralized here so stats / changelog / etc.
 * pages stay consistent.
 */
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  /** Center vs left-align. Defaults to left (used for /stats sections). */
  align?: "left" | "center";
}
const { eyebrow, title, subtitle, align = "left" } = Astro.props;
const wrap = align === "center" ? "text-center" : "text-left";
---
<div class={`mb-6 ${wrap}`}>
  <div class="text-xs font-semibold uppercase tracking-widest text-purple-primary">
    {eyebrow}
  </div>
  <h2 class="mt-2 text-2xl font-medium tracking-tight text-text-primary md:text-3xl">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-1.5 text-sm text-text-secondary">
      {subtitle}
    </p>
  )}
</div>
