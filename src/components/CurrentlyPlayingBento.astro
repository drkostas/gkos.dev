---
import BentoCard from "./BentoCard.astro";
---

<BentoCard height="h-[300px]">
  <div class="flex flex-col">
    <div class="z-10 h-full">
      <div class="flex h-full flex-col justify-between">
        <h2 class="mb-2 text-base font-medium">Recent Favorite</h2>
        <p class="max-h-[150px] overflow-hidden text-base text-text-secondary">
          <span class="line-clamp-4 text-ellipsis">
            I'm listening to <a class="font-semibold" href="https://open.spotify.com/track/5hcRWT88VLlbhEMh4efCMy">The Sun Yet Shines</a> by Bear McCreary off the album The Lord of the Rings: The Rings of Power.
          </span>
        </p>
      </div>
    </div>
  </div>
</BentoCard>
