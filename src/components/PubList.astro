---
// C-style publications list — venue · title · year, with click-to-expand summary.
// Used by /publications and the publications-{a..h} widget variant pages.

import PubLinks from "@/components/PubLinks.astro";
import { getPublications } from "@/lib/publicationsData";

const { byYear, years } = await getPublications();

// Display the venue without the trailing year — keeps "(Under Review)", "(MDPI)", etc.
function venueLabel(conference: string): string {
  return conference.replace(/\s*\d{4}/, "").trim();
}
---

<div class="space-y-10">
  {years.map((year) => (
    <section>
      <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-text-secondary">{year}</h2>
      <ul class="divide-y divide-border-primary/50">
        {byYear[year].map((pub) => (
          <li>
            <details class="group py-3">
              <summary class="flex cursor-pointer items-baseline gap-3 list-none">
                <span class="font-mono text-xs whitespace-nowrap text-text-tertiary">{venueLabel(pub.conference)}</span>
                <span class="flex-1 truncate text-sm font-medium text-text-primary group-hover:text-purple-primary">{pub.title}</span>
                <span class="text-xs text-text-tertiary">{pub.citations > 0 ? `${pub.citations} cit` : ""}</span>
              </summary>
              <div class="mt-3 space-y-3 pl-1">
                <p class="text-sm leading-6 text-text-secondary">{pub.abstract}</p>
                {pub.fullAbstract && (
                  <details class="group/abs">
                    <summary class="inline-flex cursor-pointer items-center gap-1 font-mono text-[11px] uppercase tracking-wider text-indigo-600 hover:underline list-none">
                      <span class="group-open/abs:hidden">Show full abstract</span>
                      <span class="hidden group-open/abs:inline">Hide full abstract</span>
                      <svg class="h-3 w-3 transition-transform group-open/abs:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4.5L6 7.5L9 4.5" /></svg>
                    </summary>
                    <p class="mt-2 text-sm leading-6 text-text-secondary">{pub.fullAbstract}</p>
                  </details>
                )}
                <PubLinks paper={pub.link} code={pub.code} arxiv={pub.arxiv} size="xs" />
              </div>
            </details>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
