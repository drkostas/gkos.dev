---
import BentoCard from "./BentoCard.astro";
---

<BentoCard class="group" height="h-full">
  <h2 class="mb-2 font-medium text-text-primary">Currently Reading</h2>
  <div class="relative h-full">
    <div class="absolute left-10 top-6 h-full origin-bottom-left transition-transform duration-300 ease-in-out group-hover:-rotate-3">
      <div class="relative aspect-video h-full w-96 overflow-hidden rounded bg-red-500">
        <div class="absolute left-5 h-full w-2 bg-slate-900/20 blur-sm"></div>
        <img src="/red_rising_cover.jpeg" alt="Red Rising book cover" class="h-full" />
      </div>
    </div>
  </div>
  <!-- Gradient overlay -->
  <div class="absolute inset-0 h-full w-full bg-gradient-to-t from-white via-transparent to-transparent"></div>
</BentoCard>
