---
import BentoCard from "./BentoCard.astro";
import { siteMetadata } from "@/data/siteMetadata";

const dayNames = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
const currentDate = new Date();
const currentMonth = currentDate.toLocaleString("default", { month: "long" });
const currentYear = currentDate.getFullYear();
// Start the month grid on the correct day of the week.
const firstDayOfWeek = new Date(currentYear, currentDate.getMonth(), 1).getDay();
const daysInMonth = new Date(currentYear, currentDate.getMonth() + 1, 0).getDate();
// Fallback to mailto until a Cal.com (or similar) booking URL is set up.
const bookingLink = siteMetadata.email;

// Hardcoded highlighted days to suggest a few available slots in the preview.
const highlightedDays = new Set<number>([1, 4]);
---
<BentoCard height="h-[220px]" linkTo={bookingLink}>
  <div class="group grid h-full grid-cols-12 gap-5">
    <div class="col-span-5 text-balance md:col-span-5">
      <h2 class="mb-4 text-base font-medium text-text-primary">Book a call with me</h2>
      <p class="mb-2 text-text-secondary">I'd love to chat even if there's no agenda!</p>
    </div>
    <div class="absolute left-[43%] top-7 transition-all duration-500 ease-out md:-right-14 md:left-auto md:group-hover:-right-12 md:group-hover:top-5">
      <div>
        <div class="h-[278px] w-[550px] rounded-[20px] border border-border-primary p-2 transition-colors duration-100 group-hover:border-indigo-400">
          <div class="h-full rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0] p-3" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;">
            <div class="flex items-center space-x-2">
              <p class="text-sm text-gray-500"><span class="font-medium">{currentMonth}, {currentYear}</span></p>
              <span class="h-1 w-1 rounded-full bg-text-tertiary">&nbsp;</span>
              <p class="text-xs text-text-tertiary">30 min call</p>
            </div>
            <div class="mt-4 grid grid-cols-7 grid-rows-5 gap-2 px-4">
              {dayNames.map((day) => (
                <div class="col-span-1 row-span-1 flex h-8 w-8 items-center justify-center">
                  <span class="font-medium text-xs">{day}</span>
                </div>
              ))}
              {Array.from({ length: firstDayOfWeek }).map((_, i) => (
                <div class="col-span-1 row-span-1 h-8 w-8"></div>
              ))}
              {Array.from({ length: daysInMonth }).map((_, i) => {
                const day = i + 1;
                const isHighlighted = highlightedDays.has(day);
                return (
                  <div
                    class:list={[
                      "col-span-1 row-span-1 flex h-8 w-8 items-center justify-center rounded",
                      isHighlighted
                        ? "bg-white/75 text-text-secondary hover:bg-white"
                        : "text-text-tertiary",
                    ]}
                  >
                    <span class="font-medium text-sm">{day}</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BentoCard>
