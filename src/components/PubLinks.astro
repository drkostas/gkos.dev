---
const { paper, code, arxiv, huggingface, projectSlug, size = "sm" } = Astro.props;
const sz = size === "xs" ? "text-xs" : "text-sm";
const items = [
  paper && { label: "Paper", href: paper },
  code && { label: "Code", href: code },
  arxiv && { label: "arXiv", href: arxiv },
  huggingface && { label: "Checkpoints", href: huggingface },
  projectSlug && { label: "Project", href: `/projects#project-${projectSlug}` },
].filter(Boolean) as { label: string; href: string }[];
---

{items.length > 0 && (
  <div class="flex flex-wrap gap-4">
    {items.map((it) => (
      <a
        href={it.href}
        target={it.href.startsWith("/") ? "_self" : "_blank"}
        rel={it.href.startsWith("/") ? undefined : "noopener noreferrer"}
        class:list={["flex items-center font-medium text-indigo-600 hover:underline", sz]}
      >
        <span class="leading-6">{it.label}</span>
        <svg class="relative ml-2.5 mt-px overflow-visible" width="3" height="6" viewBox="0 0 3 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M0 0L3 3L0 6"></path></svg>
      </a>
    ))}
  </div>
)}
