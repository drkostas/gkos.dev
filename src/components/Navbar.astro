---
import SocialPill from "./SocialPill.astro";

const navigationLinks = [
  { name: "Home", link: "/" },
  { name: "About", link: "/about" },
  { name: "Projects", link: "/projects" },
  { name: "Publications", link: "/publications" },
  { name: "Blog", link: "/blog" },
  { name: "Inspirations", link: "/inspirations" },
  { name: "Workbench", link: "/workbench" },
];

const currentPath = Astro.url.pathname;

function isActive(link: string): boolean {
  if (link === "/") return currentPath === "/";
  return currentPath === link || currentPath.startsWith(link + "/");
}
---

<header role="banner">
  <!-- Desktop Nav -->
  <nav
    aria-label="Desktop navigation"
    class="hidden h-16 w-full items-center justify-between border-b border-border-primary/50 px-4 md:flex"
  >
    <div class="w-[104px]">
      <a href="/" aria-label="Home">
        <img
          class="h-6 w-6"
          src="/gkos_logo.png"
          alt="Kostas's Logo"
        />
      </a>
    </div>
    <ul
      class="flex place-items-center space-x-4 rounded-full border border-border-primary px-5 py-2 text-sm text-gray-500"
    >
      {navigationLinks.map((link) => (
        <li>
          <a
            href={link.link}
            class:list={[
              "font-medium hover:text-text-primary",
              isActive(link.link) ? "text-text-primary" : "text-gray-500",
            ]}
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a
        href="/explore"
        class:list={[
          "flex h-8 w-8 items-center justify-center rounded-full border bg-bg-primary transition-colors hover:border-purple-primary hover:text-purple-primary",
          isActive("/explore")
            ? "border-purple-primary text-purple-primary"
            : "border-border-primary text-text-secondary",
        ]}
        aria-label="Explore mode"
        title="Explore mode"
        aria-current={isActive("/explore") ? "page" : undefined}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="6" x2="10" y1="11" y2="11" />
          <line x1="8" x2="8" y1="9" y2="13" />
          <line x1="15" x2="15.01" y1="12" y2="12" />
          <line x1="18" x2="18.01" y1="10" y2="10" />
          <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258A4 4 0 0 0 17.32 5z" />
        </svg>
      </a>
      <button
        id="theme-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-border-primary bg-bg-primary text-text-secondary transition-colors hover:border-purple-primary hover:text-purple-primary"
        aria-label="Switch to dark mode"
        aria-pressed="false"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="block h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <SocialPill />
    </div>
  </nav>

  <!-- Mobile Nav -->
  <nav
    aria-label="Mobile navigation"
    class="flex h-16 items-center justify-between gap-2.5 border-b border-border-primary/50 px-3 md:hidden"
  >
    <a href="/" aria-label="Home">
      <img
        class="h-8 w-8"
        src="/gkos_logo.png"
        alt="Kostas's Logo"
      />
    </a>

    <div class="flex items-center gap-2">
      <a
        href="/explore"
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-full border bg-bg-primary transition-colors hover:border-purple-primary hover:text-purple-primary",
          isActive("/explore")
            ? "border-purple-primary text-purple-primary"
            : "border-border-primary text-text-secondary",
        ]}
        aria-label="Explore mode"
        aria-current={isActive("/explore") ? "page" : undefined}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="6" x2="10" y1="11" y2="11" />
          <line x1="8" x2="8" y1="9" y2="13" />
          <line x1="15" x2="15.01" y1="12" y2="12" />
          <line x1="18" x2="18.01" y1="10" y2="10" />
          <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258A4 4 0 0 0 17.32 5z" />
        </svg>
      </a>
      <button
        id="theme-toggle-mobile"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border-primary bg-bg-primary text-text-secondary transition-colors hover:border-purple-primary hover:text-purple-primary"
        aria-label="Switch to dark mode"
        aria-pressed="false"
      >
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="block h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    <button
      id="mobile-menu-btn"
      class="rounded-full border border-border-primary p-2"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M0 4.99599C0 4.77599 0.105357 4.56501 0.292893 4.40945C0.48043 4.2539 0.734784 4.1665 1 4.1665H19C19.2652 4.1665 19.5196 4.2539 19.7071 4.40945C19.8946 4.56501 20 4.77599 20 4.99599C20 5.21598 19.8946 5.42696 19.7071 5.58252C19.5196 5.73808 19.2652 5.82547 19 5.82547H1C0.734784 5.82547 0.48043 5.73808 0.292893 5.58252C0.105357 5.42696 0 5.21598 0 4.99599ZM5 9.99942C5 9.77943 5.10536 9.56845 5.29289 9.41289C5.48043 9.25733 5.73478 9.16994 6 9.16994H19C19.2652 9.16994 19.5196 9.25733 19.7071 9.41289C19.8946 9.56845 20 9.77943 20 9.99942C20 10.2194 19.8946 10.4304 19.7071 10.586C19.5196 10.7415 19.2652 10.8289 19 10.8289H6C5.73478 10.8289 5.48043 10.7415 5.29289 10.586C5.10536 10.4304 5 10.2194 5 9.99942ZM11.8333 14.1742C11.5681 14.1742 11.3138 14.2616 11.1262 14.4172C10.9387 14.5727 10.8333 14.7837 10.8333 15.0037C10.8333 15.2237 10.9387 15.4347 11.1262 15.5902C11.3138 15.7458 11.5681 15.8332 11.8333 15.8332H19C19.2652 15.8332 19.5196 15.7458 19.7071 15.5902C19.8946 15.4347 20 15.2237 20 15.0037C20 14.7837 19.8946 14.5727 19.7071 14.4172C19.5196 14.2616 19.2652 14.1742 19 14.1742H11.8333Z"
          fill="currentColor"></path>
      </svg>
    </button>
    </div>

    <!-- Mobile Menu Dialog -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-50 hidden bg-bg-primary py-1 md:hidden"
    >
      <div class="size-full overflow-y-auto">
        <div class="flex h-14 items-center justify-between px-3">
          <a href="/" aria-label="Home">
            <img
              class="h-8 w-8"
              src="/gkos_logo.png"
              alt="Kostas's Logo"
            />
          </a>
          <button
            id="mobile-menu-close"
            class="rounded-full border border-border-primary p-2"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" class="h-5 w-5 text-text-primary">
              <path
                d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z"
              ></path>
            </svg>
          </button>
        </div>
        <div class="grid grid-cols-1 gap-1 px-1 pb-1 sm:px-3 sm:pb-3">
          {navigationLinks.map(({ name, link }) => (
            <a
              href={link}
              class:list={[
                "rounded-lg px-3 py-2 text-xl/9 font-medium",
                isActive(link) ? "text-text-primary" : "text-text-secondary",
              ]}
              aria-current={isActive(link) ? "page" : undefined}
            >
              {name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const close = document.getElementById("mobile-menu-close");

  btn?.addEventListener("click", () => {
    menu?.classList.remove("hidden");
    document.body.classList.add("modal-open");
    btn.setAttribute("aria-expanded", "true");
  });

  close?.addEventListener("click", () => {
    menu?.classList.add("hidden");
    document.body.classList.remove("modal-open");
    btn?.setAttribute("aria-expanded", "false");
  });

  // Close on link click
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      document.body.classList.remove("modal-open");
      btn?.setAttribute("aria-expanded", "false");
    });
  });

  // Theme toggle (both desktop and mobile buttons). aria-pressed and aria-label
  // stay in sync with the actual mode so screen readers announce the right action.
  function syncThemeToggleA11y() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((btn) => {
      btn.setAttribute("aria-pressed", isDark ? "true" : "false");
      btn.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
    });
  }
  syncThemeToggleA11y();
  document.querySelectorAll("#theme-toggle, #theme-toggle-mobile").forEach((btn) => {
    btn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      syncThemeToggleA11y();
    });
  });
</script>
