---
import GameLayout from "@/layouts/GameLayout.astro";
import ExploreApp from "@/components/game/ExploreApp";
---

<GameLayout title="Explore Mode | Kostas Georgiou">
  <!--
    ExploreApp manages the full flow:
      1. GameLoadingScreen (progress bar + press-to-start)
      2. OpeningScreen (title → CONTINUE/NEW GAME menu)
      3. BirchSpeechLayer (new game only — name/gender selection)
      4. PhaserGame (the actual game world)

    Loaded with client:only="react" because Phaser needs window/document.
  -->
  <ExploreApp client:only="react" />
</GameLayout>
