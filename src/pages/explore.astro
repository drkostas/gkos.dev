---
import GameLayout from "@/layouts/GameLayout.astro";
---

<GameLayout title="Explore Mode | Kostas Georgiou">
  <!--
    PhaserGame is loaded with client:only="react" — it never runs during SSR
    because Phaser requires window/document. The GameLoadingScreen (inside
    PhaserGame) covers the black canvas during asset loading, then fades out
    when OverworldScene starts.
  -->
  <div class="h-full" id="game-root"></div>
</GameLayout>

<script>
  // Dynamically import PhaserGame to avoid SSR issues and keep the main
  // bundle lean (Phaser is ~1MB). Only loads when user visits /explore.
  async function bootGame() {
    const { default: React } = await import("react");
    const { createRoot } = await import("react-dom/client");
    const { default: PhaserGame } = await import("@/components/game/PhaserGame");

    const root = document.getElementById("game-root");
    if (root) {
      createRoot(root).render(React.createElement(PhaserGame));
    }
  }
  bootGame();
</script>
