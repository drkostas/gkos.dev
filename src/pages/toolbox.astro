---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import BorderCard from "@/components/BorderCard.astro";
import { NewsletterSignUpReact } from "@/components/NewsletterSignUpReact";
import { hardwareData, softwareData } from "@/data/toolbox";
---

<Layout title="Toolbox | Braydon Coyer">
  <div class="relative">
    <span class="absolute left-1/2 top-20 -translate-y-1/2 translate-x-1/2">
      <span class="absolute left-1/2 h-px w-full -translate-x-1/2 transform bg-border-primary/50"></span>
    </span>
    <div class="relative space-y-10 md:space-y-16">
      <div class="mx-auto text-balance pt-14 md:pt-16">
        <GridWrapper>
          <h1 class="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
            Hardware && software I keep in my toolbox.
          </h1>
        </GridWrapper>
      </div>
      <span class="absolute left-1/2 top-40 -translate-y-1/2 translate-x-1/2">
        <span class="absolute left-1/2 h-px w-full -translate-x-1/2 transform bg-border-primary/50"></span>
      </span>

      <!-- Applications -->
      <div class="relative">
        <GridWrapper>
          <div class="text-center text-sm font-medium text-indigo-600">
            <span>Applications</span>
          </div>
        </GridWrapper>
      </div>

      <GridWrapper>
        <div class="relative grid grid-cols-3 place-items-center md:grid-cols-4 lg:grid-cols-8 lg:gap-6">
          {softwareData.map((item) => (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group no-underline transition-all duration-500 group-hover:-translate-y-3"
            >
              <div class="group inline-block text-center">
                <div class="h-28 w-28 rounded-[20px] border border-border-primary bg-bg-primary p-2 transition-all duration-300 group-hover:-translate-y-3 group-hover:border-indigo-400">
                  <div
                    class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]"
                    style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"
                  >
                    <img class="h-10 w-10" alt={item.title} src={item.imgSrc} />
                  </div>
                </div>
                {item.title ? (
                  <p class="mt-3 text-sm text-gray-500">{item.title}</p>
                ) : null}
              </div>
            </a>
          ))}
        </div>
      </GridWrapper>

      <!-- Hardware -->
      <div class="relative">
        <GridWrapper>
          <div class="text-center text-sm font-medium text-indigo-600">
            <span>Hardware</span>
          </div>
        </GridWrapper>
      </div>

      <div>
        <GridWrapper>
          <div class="grid grid-cols-1 grid-rows-2 gap-2 md:grid-cols-3">
            {hardwareData.map((item) => (
              <a href={item.link} class="group block h-full">
                <BorderCard>
                  <div class="flex flex-col space-y-3">
                    <p class="text-base font-semibold leading-5 text-text-primary">
                      {item.title}
                    </p>
                    <p class="leading-6 text-gray-500">{item.description}</p>
                  </div>
                  <span class="inline-block text-right">
                    <span class="text-sm text-purple-primary/50 group-hover:text-purple-primary">
                      Learn more
                    </span>
                  </span>
                </BorderCard>
              </a>
            ))}
          </div>
        </GridWrapper>
      </div>

      <NewsletterSignUpReact client:visible />
    </div>
  </div>
</Layout>
