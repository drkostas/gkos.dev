---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { GetInTouchReact } from "@/components/GetInTouchReact";
import { BlogSearch } from "@/components/BlogSearch";
import { FeaturedBlogCardReact } from "@/components/FeaturedBlogCardReact";
import { getCollection } from "astro:content";

const allBlogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

// Extract unique categories across all posts
const categoriesSet = new Set<string>();
for (const post of allBlogPosts) {
  for (const cat of post.data.categories || []) {
    categoriesSet.add(cat);
  }
}
const categories = Array.from(categoriesSet);

// Read category filter from URL
const currentCategory = Astro.url.searchParams.get("category")?.toLowerCase() || "";
const displayedPosts = currentCategory
  ? allBlogPosts.filter((post) =>
      post.data.categories?.map((c: string) => c.toLowerCase()).includes(currentCategory),
    )
  : allBlogPosts;

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title="Blog | Kostas Georgiou">
  <div class="mt-14 space-y-16 md:mt-16">
    <GridWrapper>
      <h1 class="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
        {currentCategory ? `Articles about ${currentCategory}` : "Insightful and helpful content curated for you."}
      </h1>
    </GridWrapper>

    {!currentCategory && allBlogPosts.length > 0 && (
    <GridWrapper>
      <ul class="z-50 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
        {allBlogPosts.slice(0, 4).map((post, index) => (
          <FeaturedBlogCardReact
            slug={post.id}
            imageName={post.data.imageName}
            title={post.data.title}
            summary={post.data.summary}
            direction={index % 2 === 0 ? "left" : "right"}
            className={index === 3 ? "hidden md:flex lg:hidden" : undefined}
            client:visible
          />
        ))}
      </ul>
    </GridWrapper>
    )}

    <div>
      <!-- Category Select -->
      <!-- Search -->
      <div class="px-4">
        <BlogSearch
          posts={allBlogPosts.map(p => ({ id: p.id, title: p.data.title, summary: p.data.summary }))}
          client:load
        />
      </div>

      <!-- Category pills -->
      <div class="border-b border-border-primary/50 px-4 pb-6">
        <div class="flex flex-wrap gap-2">
          <a
            href="/blog"
            class:list={[
              "rounded-full border px-3 py-1.5 text-xs font-medium transition-colors",
              !currentCategory
                ? "border-dark-primary bg-dark-primary text-white"
                : "border-border-primary text-text-secondary hover:border-purple-primary hover:text-purple-primary",
            ]}
          >
            All
          </a>
          {categories.map((cat) => (
            <a
              href={`/blog?category=${encodeURIComponent(cat.toLowerCase())}`}
              class:list={[
                "rounded-full border px-3 py-1.5 text-xs font-medium transition-colors",
                cat.toLowerCase() === currentCategory
                  ? "border-dark-primary bg-dark-primary text-white"
                  : "border-border-primary text-text-secondary hover:border-purple-primary hover:text-purple-primary",
              ]}
            >
              {cat}
            </a>
          ))}
        </div>
      </div>

      <!-- Post list -->
      <ul class="flex flex-col">
        {displayedPosts.length > 0 ? (
          displayedPosts.map((post) => (
            <li>
              <div class="block rounded-lg transition-colors hover:bg-white/60">
                <article>
                  <div class="group grid h-full grid-cols-1 md:grid-cols-12">
                    <div class="hidden space-y-2 p-4 md:col-span-3 md:col-start-1 md:block lg:col-span-2">
                      <div class="font-mono text-sm leading-none text-text-secondary">
                        <time datetime={post.data.publishedAt.toISOString()}>
                          {formatDate(post.data.publishedAt)}
                        </time>
                      </div>
                    </div>
                    <div class="col-start-4 hidden h-full border-x border-border-primary md:block md:border-dashed"></div>
                    <div class="group col-span-8 flex w-full flex-grow flex-col py-4 md:col-start-5 md:col-end-12 md:p-4">
                      <div class="z-10 text-balance">
                        <h2 class="mb-3 text-base font-medium leading-6 tracking-tight text-slate-900 md:leading-none">
                          {post.data.title}
                        </h2>
                        <p class="mb-3 flex-grow text-base leading-6 text-text-secondary">
                          {post.data.summary}
                        </p>
                        <a
                          href={`/blog/${post.id}`}
                          class="flex items-center text-sm font-medium text-indigo-600"
                        >
                          <span class="text-sm leading-6">Read More</span>
                          <svg
                            class="relative ml-2.5 mt-px overflow-visible"
                            width="3"
                            height="6"
                            viewBox="0 0 3 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M0 0L3 3L0 6"></path>
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
              </div>
              <div class="h-0 w-full border-t border-border-primary/50"></div>
            </li>
          ))
        ) : (
          <li class="py-12">
            <div class="mx-auto max-w-md rounded-2xl border border-dashed border-border-primary/60 bg-bg-primary/50 p-10 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-border-primary bg-bg-primary">
                <svg class="h-5 w-5 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
                  <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
                </svg>
              </div>
              <h3 class="font-medium text-text-primary">No posts yet</h3>
              <p class="mt-1 text-sm text-text-secondary">
                {currentCategory
                  ? `Nothing published in ${currentCategory} yet.`
                  : "New posts are brewing. Check back soon."}
              </p>
            </div>
          </li>
        )}
      </ul>
    </div>

    <GetInTouchReact client:visible />
  </div>
</Layout>
