---
/**
 * Pokémon explore-mode level editor.
 * Dev-only: this is a content-authoring tool, not something visitors should see.
 * In production builds the route returns 404 so it doesn't ship publicly.
 */
export const prerender = false;

import EditorApp from "@/components/editor/EditorApp";

// Guard goes AFTER imports so Astro's compiler doesn't treat them as
// unreachable.
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pokemon World Designer IDE</title>
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0f0f23; color: #e5e5e5; font-family: 'Inter', system-ui, -apple-system, sans-serif; overflow: hidden; height: 100vh; font-size: 11px; }
  </style>
</head>
<body>
  <EditorApp client:only="react" />
</body>
</html>
