---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { connections } from "@/data/connections";

// Sort: connected first (alphabetical), then unconnected (alphabetical)
const sortedConnections = [...connections].sort((a, b) => {
  if (a.isConnected === b.isConnected) return a.name.localeCompare(b.name);
  return a.isConnected ? -1 : 1;
});

function formatConnectedDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { month: "numeric", day: "numeric", year: "2-digit" });
}
---

<Layout title="Connections | Kostas Georgiou">
  <div class="relative space-y-16">
    <GridWrapper>
      <h1 class="mx-auto mt-16 max-w-2xl text-balance text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
        An evolving list of people I've met and those I wish to meet.
      </h1>
    </GridWrapper>

    <div class="relative">
      <div class="relative mb-12 grid auto-rows-auto grid-cols-3 place-items-center justify-center gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8">
        <span class="absolute top-0">
          <span class="absolute left-1/2 h-px w-full -translate-x-1/2 transform bg-border-primary/50"></span>
        </span>
        {sortedConnections.map((person) => (
          <div class="group min-w-0 no-underline transition-all duration-500">
            <div class="group inline-block text-center">
              <div
                class:list={[
                  "relative h-28 w-28 rounded-[20px] border border-border-primary bg-bg-primary p-2 transition-all duration-300",
                  person.isConnected ? "group-hover:-translate-y-3 group-hover:border-indigo-400" : "",
                ]}
              >
                {person.isConnected && person.connectedDate ? (
                  <div class="absolute -bottom-2 left-1/2 w-full -translate-x-1/2 text-nowrap rounded-full bg-indigo-400 px-1.5 py-1 text-center text-xs text-white">
                    <span>
                      Met on <time>{formatConnectedDate(person.connectedDate)}</time>
                    </span>
                  </div>
                ) : null}
                <div
                  class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]"
                  style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"
                >
                  <img
                    class:list={[
                      "h-14 w-14 rounded transition-all duration-300",
                      !person.isConnected ? "grayscale" : "",
                    ]}
                    alt={person.name}
                    src={person.profile_picture}
                  />
                </div>
              </div>
              {person.name && (
                <div class="mt-3">
                  <p class="text-sm text-gray-500">{person.name}</p>
                </div>
              )}
            </div>
          </div>
        ))}
        <span class="absolute bottom-0">
          <span class="absolute left-1/2 h-px w-full -translate-x-1/2 transform bg-border-primary/50"></span>
        </span>
      </div>
    </div>
  </div>
</Layout>
