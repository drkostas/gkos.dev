 10.5C18.2761 10.5 18.5 10.7239 18.5 11L20 11C20 9.89544 19.1046 9.00001 18 9.00001L18 10.5Z" fill="#64748b"></path>
                        <path d="M5.75 9.5H6.25V8H5.75V9.5ZM6.5 9.75V18.25H8V9.75H6.5ZM6.25 18.5H5.75V20H6.25V18.5ZM5.5 18.25V9.75H4V18.25H5.5ZM5.75 18.5C5.61193 18.5 5.5 18.3881 5.5 18.25H4C4 19.2165 4.7835 20 5.75 20V18.5ZM6.5 18.25C6.5 18.3881 6.38807 18.5 6.25 18.5V20C7.2165 20 8 19.2165 8 18.25H6.5ZM6.25 9.5C6.38807 9.5 6.5 9.61193 6.5 9.75H8C8 8.7835 7.2165 8 6.25 8V9.5ZM5.75 8C4.7835 8 4 8.7835 4 9.75H5.5C5.5 9.61193 5.61193 9.5 5.75 9.5V8Z" fill="#64748b"></path>
                      </svg>
                    </div>
                    <span class="text-lg font-semibold tabular-nums text-text-primary">{reactions.like.toLocaleString()}</span>
                    <span class="text-xs text-text-tertiary">Likes</span>
                  </div>
                  <!-- Heart -->
                  <div class="flex flex-col items-center justify-center rounded-xl border border-border-primary/50 bg-white/50 p-3">
                    <div class="mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24">
                        <path d="M9.497 10.877c-.95-1.233-2.534-1.565-3.724-.436-1.19 1.13-1.357 3.019-.423 4.355l4.147 4.454 4.146-4.454c.934-1.336.787-3.237-.423-4.355-1.21-1.117-2.774-.797-3.723.436Z" fill="transparent" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </div>
                    <span class="text-lg font-semibold tabular-nums text-text-primary">{reactions.heart.toLocaleString()}</span>
                    <span class="text-xs text-text-tertiary">Hearts</span>
                  </div>
                  <!-- Celebrate -->
                  <div class="flex flex-col items-center justify-center rounded-xl border border-border-primary/50 bg-white/50 p-3">
                    <div class="mb-2">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.89062 9.28125L4.87279 17.7937C4.44606 18.628 5.29889 19.5379 6.16008 19.1671L14.6016 16.1875" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                        <path d="M13.3196 10.9774C14.9594 12.8695 15.698 15.085 14.9691 15.9259C14.2403 16.7669 12.3202 15.9147 10.6804 14.0226C9.04057 12.1305 8.30205 9.91499 9.03085 9.07406C9.75966 8.23313 11.6798 9.08527 13.3196 10.9774Z" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                        <path d="M11.5 5C11.5 5.27614 11.2761 5.5 11 5.5C10.7239 5.5 10.5 5.27614 10.5 5C10.5 4.72386 10.7239 4.5 11 4.5C11.2761 4.5 11.5 4.72386 11.5 5Z" stroke="#64748b" fill="transparent"></path>
                      </svg>
                    </div>
                    <span class="text-lg font-semibold tabular-nums text-text-primary">{reactions.celebrate.toLocaleString()}</span>
                    <span class="text-xs text-text-tertiary">Celebrates</span>
                  </div>
                  <!-- Insightful -->
                  <div class="flex flex-col items-center justify-center rounded-xl border border-border-primary/50 bg-white/50 p-3">
                    <div class="mb-2">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4.75C8.5 4.75 6.75 7.5 6.75 10C6.75 14 9.75 14.5 9.75 16V18.2505C9.75 18.8028 10.1977 19.25 10.75 19.25H13.25C13.8023 19.25 14.25 18.8028 14.25 18.2505V16C14.25 14.5 17.25 14 17.25 10C17.25 7.5 15.5 4.75 12 4.75Z" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="transparent"></path>
                        <path d="M10 16.75H14" stroke="#64748b" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg>
                    </div>
                    <span class="text-lg font-semibold tabular-nums text-text-primary">{reactions.insightful.toLocaleString()}</span>
                    <span class="text-xs text-text-tertiary">Insightful</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Community Messages -->
          <div class="md:col-span-4">
            <div class="group relative flex h-full min-h-[340px] flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <!-- Dot pattern bg -->
              <div class="absolute inset-0 bg-[radial-gradient(rgb(var(--color-border-primary)/0.4)_1px,transparent_2px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
              <div class="pointer-events-none absolute inset-0 z-30 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

              <!-- Stacked cards -->
              <div class="absolute inset-0 flex items-center justify-center pb-16">
                <div class="relative h-32 w-40">
                  <!-- Card 1 (back-left) -->
                  <svg class="absolute left-1/2 top-1/2 w-36" style="z-index: 1; transform: translate(calc(-50% + -15px), calc(-50% + 4px)) rotate(-9.6deg) scale(0.96); transform-origin: center;" viewBox="-15 -15 160 155" fill="none">
                    <defs>
                      <linearGradient id="cg1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#90D2AA"></stop><stop offset="100%" stop-color="#FEFFB4"></stop></linearGradient>
                      <filter id="cs1" x="-20%" y="-20%" width="150%" height="150%"><feDropShadow dx="4" dy="4" stdDeviation="8" flood-opacity="0.15"></feDropShadow></filter>
                    </defs>
                    <g filter="url(#cs1)"><rect width="120" height="115" x="5" y="5" rx="8" fill="#F7F7F8"></rect></g>
                    <rect x="10" y="10" width="110" height="90" rx="4" fill="url(#cg1)" opacity="0.85"></rect>
                    <circle cx="85" cy="35" r="25" fill="white" opacity="0.3"></circle>
                    <circle cx="40" cy="60" r="18" fill="white" opacity="0.2"></circle>
                    <rect x="25" y="35" width="50" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <rect x="25" y="50" width="35" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <circle cx="26" cy="110" r="7" fill="#D1D5DB"></circle>
                    <rect x="40" y="106" width="50" height="7" rx="3" fill="#E5E7EB"></rect>
                  </svg>
                  <!-- Card 2 (center) -->
                  <svg class="absolute left-1/2 top-1/2 w-36" style="z-index: 3; transform: translate(-50%, -50%) rotate(0deg) scale(1); transform-origin: center;" viewBox="-15 -15 160 155" fill="none">
                    <defs>
                      <linearGradient id="cg2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#C48EFF"></stop><stop offset="100%" stop-color="#FCCEED"></stop></linearGradient>
                      <filter id="cs2" x="-20%" y="-20%" width="150%" height="150%"><feDropShadow dx="4" dy="4" stdDeviation="8" flood-opacity="0.15"></feDropShadow></filter>
                    </defs>
                    <g filter="url(#cs2)"><rect width="120" height="115" x="5" y="5" rx="8" fill="#F7F7F8"></rect></g>
                    <rect x="10" y="10" width="110" height="90" rx="4" fill="url(#cg2)" opacity="0.85"></rect>
