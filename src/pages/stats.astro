---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { getCollection } from "astro:content";

const allBlogPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
const allChangelog = (await getCollection("changelog")).filter((p) => !p.data.draft);
const totalPosts = allBlogPosts.length;
const totalChangelogs = allChangelog.length;

// Static data (matching Braydon's site)
const totalArticles = 47;
const wordsWritten = 11078;
const readingTime = "56m";
const coffeeCups = 22;

const categories = [
  { name: "programming", count: 28 },
  { name: "react", count: 15 },
  { name: "css", count: 14 },
  { name: "javascript", count: 12 },
  { name: "angular", count: 8 },
  { name: "career", count: 5 },
];
const maxCategoryCount = Math.max(...categories.map((c) => c.count));

const barColors = [
  "bg-purple-500",
  "bg-indigo-500",
  "bg-blue-500",
  "bg-cyan-500",
  "bg-teal-500",
  "bg-emerald-500",
];

// Top articles (placeholder data)
const topViewedArticles = [
  { title: "How to Build a Fullstack App with Next.js", count: 12840 },
  { title: "React Server Components Explained", count: 9420 },
  { title: "CSS Grid vs Flexbox: A Complete Guide", count: 7310 },
  { title: "TypeScript Tips for Better Code", count: 5890 },
];

const mostReactedArticles = [
  { title: "My Journey from Mobile to Web Dev", count: 342 },
  { title: "Angular vs React: An Honest Take", count: 287 },
  { title: "Building Accessible Websites", count: 214 },
  { title: "Career Advice for Junior Developers", count: 198 },
];

// Engagement data
const totalViews = 0;
const reactions = { like: 0, heart: 0, celebrate: 0, insightful: 0 };
const communityMessages = 0;
const changelogUpdates = 14;

// Days since revamp
const REVAMP_DATE = new Date("2025-03-31");
const now = new Date();
const diffTime = now.getTime() - REVAMP_DATE.getTime();
const daysSinceRevamp = Math.floor(diffTime / (1000 * 60 * 60 * 24));

// GitHub data
const githubStars = 0;
const githubForks = 0;
const githubCommits = 0;

// Generate contribution graph data (52 weeks x 7 days)
function seededRandom(seed: number) {
  let x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}

const contributionWeeks: number[][] = [];
for (let w = 0; w < 52; w++) {
  const week: number[] = [];
  for (let d = 0; d < 7; d++) {
    const r = seededRandom(w * 7 + d + 42);
    if (r < 0.3) week.push(0);
    else if (r < 0.55) week.push(1);
    else if (r < 0.75) week.push(2);
    else if (r < 0.9) week.push(3);
    else week.push(4);
  }
  contributionWeeks.push(week);
}

const levelColors = ["bg-gray-200", "bg-emerald-200", "bg-emerald-400", "bg-emerald-500", "bg-emerald-600"];

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// Changelog entries for timeline
const changelogEntries = ["Stats page", "Blog search", "Dark mode", "Reactions", "RSS feed", "Changelog", "Comments", "Analytics"];
const changelogDates = ["Apr 5", "Mar 28", "Mar 15", "Mar 8", "Feb 22", "Feb 10", "Jan 30", "Jan 15"];
---

<Layout title="Stats | Braydon Coyer">
  <div class="mt-14 space-y-12 pb-16 md:mt-16 md:space-y-16">
    <!-- Page Header -->
    <section>
      <GridWrapper>
        <div class="text-center">
          <span class="text-sm font-medium text-indigo-600">Stats</span>
        </div>
      </GridWrapper>
      <GridWrapper>
        <h1 class="mx-auto mt-4 max-w-2xl text-balance text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-5xl">
          A peek behind the curtain
        </h1>
      </GridWrapper>
      <GridWrapper>
        <p class="mx-auto mt-4 max-w-xl text-center leading-8 text-text-secondary">
          Numbers, metrics, and fun facts about this little corner of the
          internet. Updated in real-time.
        </p>
      </GridWrapper>
    </section>

    <!-- Blog Stats Section -->
    <section>
      <GridWrapper>
        <div class="mb-4">
          <h2 class="text-lg font-semibold text-text-primary">Blog Stats</h2>
          <p class="mt-0.5 text-sm text-text-secondary">Content creation metrics and popular articles</p>
        </div>
        <div class="grid grid-cols-1 gap-2 md:grid-cols-12">
          <!-- Total Articles -->
          <div class="md:col-span-2">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Total Articles</h2>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">
                  <span class="count-up" data-target={totalArticles}>0</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Most Viewed Article (spans 2 rows) -->
          <div class="md:col-span-5 md:row-span-2">
            <div class="group relative flex h-full min-h-[420px] flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-30 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

              <!-- Article preview graphic -->
              <div class="relative h-[280px] flex-shrink-0">
                <!-- Paper shadow -->
                <div class="absolute inset-4 rounded-lg bg-border-primary/40" style="transform: translate(-5px, 5px) rotate(-3deg);"></div>
                <!-- Main paper card -->
                <div class="absolute inset-4 flex flex-col overflow-hidden rounded-lg border border-border-primary bg-white shadow-sm" style="transform: rotate(1.5deg);">
                  <!-- Mini header bar -->
                  <div class="flex flex-shrink-0 items-center gap-1.5 border-b border-border-primary/50 bg-slate-50 px-3 py-2">
                    <div class="h-2 w-2 rounded-full bg-red-300"></div>
                    <div class="h-2 w-2 rounded-full bg-yellow-300"></div>
                    <div class="h-2 w-2 rounded-full bg-green-300"></div>
                    <div class="ml-2 h-2 flex-1 rounded bg-border-primary/30"></div>
                  </div>
                  <!-- Banner area -->
                  <div class="relative h-[100px] w-full flex-shrink-0 overflow-hidden bg-gradient-to-br from-purple-500 to-indigo-600">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                    <div class="absolute inset-x-0 bottom-0 p-2">
                      <p class="line-clamp-2 text-[8px] font-bold leading-tight text-white">
                        How to Build a Fullstack App with Next.js
                      </p>
                    </div>
                  </div>
                  <!-- Fake article content -->
                  <div class="flex-1 space-y-2 overflow-hidden bg-[#F7F7F8] p-2.5">
                    <div class="space-y-1">
                      <div class="h-[5px] w-full rounded-sm bg-text-secondary/25"></div>
                      <div class="h-[5px] w-full rounded-sm bg-text-secondary/25"></div>
                      <div class="h-[5px] w-[92%] rounded-sm bg-text-secondary/25"></div>
                      <div class="h-[5px] w-[85%] rounded-sm bg-text-secondary/25"></div>
                    </div>
                    <div class="space-y-1">
                      <div class="h-[5px] w-full rounded-sm bg-text-secondary/20"></div>
                      <div class="h-[5px] w-full rounded-sm bg-text-secondary/20"></div>
                      <div class="h-[5px] w-[78%] rounded-sm bg-text-secondary/20"></div>
                    </div>
                    <div class="rounded bg-slate-200/60 p-1.5">
                      <div class="space-y-1">
                        <div class="h-[4px] w-[60%] rounded-sm bg-slate-400/30"></div>
                        <div class="h-[4px] w-[75%] rounded-sm bg-slate-400/30"></div>
                        <div class="h-[4px] w-[45%] rounded-sm bg-slate-400/30"></div>
                      </div>
                    </div>
                    <div class="space-y-1">
                      <div class="h-[5px] w-full rounded-sm bg-text-secondary/15"></div>
                      <div class="h-[5px] w-[88%] rounded-sm bg-text-secondary/15"></div>
                    </div>
                  </div>
                </div>

                <!-- Fade overlay -->
                <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-32 bg-gradient-to-t from-bg-primary via-bg-primary/80 to-transparent transition-colors group-hover:from-white group-hover:via-white/80"></div>
              </div>

              <!-- Content overlay -->
              <div class="relative z-20 px-6 pb-6">
                <h2 class="mb-1 font-medium text-text-primary">Most Viewed Article</h2>
                <h3 class="mb-3 line-clamp-2 text-sm leading-snug text-text-secondary transition-colors group-hover:text-text-primary">
                  How to Build a Fullstack App with Next.js
                </h3>
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-bold tabular-nums tracking-tight text-purple-primary">
                    <span class="count-up" data-target="12840">0</span>
                  </span>
                  <span class="text-sm text-text-tertiary">views</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Coffee Consumed -->
          <div class="md:col-span-5">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <!-- Floating coffee decorations -->
              <div class="pointer-events-none absolute inset-0 overflow-hidden">
                <span class="absolute text-2xl" style="left: 10%; top: 20%; opacity: 0.15; transform: rotate(-15deg);">&#9749;</span>
                <span class="absolute text-2xl" style="left: 75%; top: 15%; opacity: 0.15; transform: rotate(10deg);">&#9749;</span>
                <span class="absolute text-2xl" style="left: 85%; top: 60%; opacity: 0.15; transform: rotate(-8deg);">&#9749;</span>
                <span class="absolute text-2xl" style="left: 15%; top: 70%; opacity: 0.15; transform: rotate(12deg);">&#9749;</span>
              </div>
              <div class="relative z-20 flex h-full flex-col">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-xl">&#9749;</div>
                <h2 class="mb-2 font-medium text-text-primary">Coffee Consumed</h2>
                <p class="text-sm text-text-secondary">Estimated fuel</p>
                <div class="mt-auto">
                  <div class="flex items-baseline gap-1">
                    <span class="text-3xl font-semibold tracking-tight text-purple-primary">
                      ~<span class="count-up" data-target={coffeeCups}>0</span>
                    </span>
                    <span class="text-sm text-text-secondary">cups</span>
                  </div>
                  <p class="mt-2 text-xs text-text-tertiary">1 cup per 500 words</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Words Written -->
          <div class="md:col-span-2">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Words Written</h2>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">
                  <span class="count-up" data-target={wordsWritten}>0</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Reading Time -->
          <div class="md:col-span-5">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Reading Time</h2>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">{readingTime}</p>
              </div>
            </div>
          </div>

          <!-- Top Viewed Articles -->
          <div class="md:col-span-5">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-4 font-medium text-text-primary">Top Viewed Articles</h2>
                <ul class="flex flex-1 flex-col justify-center space-y-3">
                  {topViewedArticles.map((article, index) => (
                    <li class="flex items-start justify-between gap-3">
                      <div class="flex items-start gap-3">
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-primary/10 text-xs font-medium text-purple-primary">
                          {index + 1}
                        </span>
                        <span class="line-clamp-2 text-sm leading-relaxed text-text-secondary">
                          {article.title}
                        </span>
                      </div>
                      <span class="shrink-0 text-xs font-semibold tabular-nums text-text-tertiary">
                        {article.count.toLocaleString()}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Category Bar Chart (spans 2 rows) -->
          <div class="md:col-span-7 md:row-span-2">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Categories</h2>
                <p class="mb-4 text-sm text-text-secondary">Articles by topic</p>
                <div class="flex flex-1 flex-col justify-center space-y-3">
                  {categories.map((category, index) => {
                    const percentage = (category.count / maxCategoryCount) * 100;
                    const color = barColors[index % barColors.length];
                    return (
                      <div class="group/bar">
                        <div class="mb-1 flex items-center justify-between">
                          <span class="truncate text-xs font-medium text-text-secondary">{category.name}</span>
                          <span class="ml-2 shrink-0 text-xs font-semibold tabular-nums text-text-tertiary">{category.count}</span>
                        </div>
                        <div class="relative h-3 w-full overflow-hidden rounded-full bg-border-primary/30">
                          <div
                            class:list={["bar-animate absolute inset-y-0 left-0 origin-left rounded-full", color]}
                            data-width={`${percentage}%`}
                            style="width: 0%;"
                          ></div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>

          <!-- Most Reacted Articles -->
          <div class="md:col-span-5">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-4 font-medium text-text-primary">Most Reacted Articles</h2>
                <ul class="flex flex-1 flex-col justify-center space-y-3">
                  {mostReactedArticles.map((article, index) => (
                    <li class="flex items-start justify-between gap-3">
                      <div class="flex items-start gap-3">
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-primary/10 text-xs font-medium text-purple-primary">
                          {index + 1}
                        </span>
                        <span class="line-clamp-2 text-sm leading-relaxed text-text-secondary">
                          {article.title}
                        </span>
                      </div>
                      <span class="shrink-0 text-xs font-semibold tabular-nums text-text-tertiary">
                        {article.count.toLocaleString()}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </GridWrapper>
    </section>

    <!-- Engagement Section -->
    <section>
      <GridWrapper>
        <div class="mb-4">
          <h2 class="text-lg font-semibold text-text-primary">Engagement</h2>
          <p class="mt-0.5 text-sm text-text-secondary">Site activity and community interactions</p>
        </div>
        <div class="grid grid-cols-1 gap-2 md:grid-cols-12">
          <!-- Site Views -->
          <div class="md:col-span-3">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <!-- SVG wave background -->
              <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl">
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 320 130" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <linearGradient id="waveGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="rgb(139, 92, 246)" stop-opacity="0.03"></stop>
                      <stop offset="40%" stop-color="rgb(129, 140, 248)" stop-opacity="0.08"></stop>
                      <stop offset="100%" stop-color="rgb(99, 102, 241)" stop-opacity="0.15"></stop>
                    </linearGradient>
                    <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="rgb(167, 139, 250)" stop-opacity="0.2"></stop>
                      <stop offset="50%" stop-color="rgb(129, 140, 248)" stop-opacity="0.5"></stop>
                      <stop offset="100%" stop-color="rgb(99, 102, 241)" stop-opacity="0.7"></stop>
                    </linearGradient>
                  </defs>
                  <path d="M -10 105 C 20 100, 35 95, 50 88 C 65 81, 75 85, 90 82 C 105 79, 115 70, 130 65 C 145 60, 155 62, 170 58 C 185 54, 195 45, 210 42 C 225 39, 235 44, 250 38 C 265 32, 280 22, 295 15 L 310 10 L 310 150 L -10 150 Z" fill="url(#waveGrad)"></path>
                  <path d="M -10 105 C 20 100, 35 95, 50 88 C 65 81, 75 85, 90 82 C 105 79, 115 70, 130 65 C 145 60, 155 62, 170 58 C 185 54, 195 45, 210 42 C 225 39, 235 44, 250 38 C 265 32, 280 22, 295 15 L 310 10" fill="none" stroke="url(#lineGrad)" stroke-width="2" stroke-linecap="round"></path>
                  <circle cx="310" cy="10" r="4" fill="rgb(99, 102, 241)"></circle>
                </svg>
              </div>
              <div class="relative z-20 flex h-full flex-col">
                <div class="mb-2 flex items-center gap-2">
                  <h2 class="font-medium text-text-primary">Total Site Views</h2>
                  <div class="flex items-center gap-1 text-emerald-500">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17l5-5 5 5"></path>
                      <path d="M7 11l5-5 5 5"></path>
                    </svg>
                  </div>
                </div>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">
                  <span class="count-up" data-target={totalViews}>0</span>
                </p>
              </div>
            </div>
          </div>

          <!-- Reaction Breakdown (spans 2 rows) -->
          <div class="md:col-span-5 md:row-span-2">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Reactions</h2>
                <p class="mb-4 text-3xl font-bold tabular-nums tracking-tight text-purple-primary">
                  {Object.values(reactions).reduce((s, c) => s + c, 0).toLocaleString()}
                  <span class="ml-2 text-sm font-normal text-text-tertiary">total</span>
                </p>
                <div class="grid flex-1 grid-cols-2 gap-3">
                  <!-- Like -->
                  <div class="flex flex-col items-center justify-center rounded-xl border border-border-primary/50 bg-white/50 p-3">
                    <div class="mb-2">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
