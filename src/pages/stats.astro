---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionEyebrow from "@/components/SectionEyebrow.astro";
import { getCollection } from "astro:content";
import { getWallMessageCount } from "@/lib/supabase";
import { SiteViewsCardReact } from "@/components/SiteViewsCardReact";
import { CvDownloadsCardReact } from "@/components/CvDownloadsCardReact";
import { UmamiStatsReact } from "@/components/UmamiStatsReact";
import { GitHubStatsReact, PyPIStatsReact, CoffeeCupsReact } from "@/components/LiveStatsReact";
import { ReactionsStatsCardReact } from "@/components/ReactionsStatsCardReact";
import { CommentsStatsCardReact } from "@/components/CommentsStatsCardReact";
import { EngagementCountriesCardReact } from "@/components/EngagementCountriesCardReact";
import { TopArticlesCardReact } from "@/components/TopArticlesCardReact";
import { projects } from "@/data/projects";

const allBlogPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
const allChangelog = (await getCollection("changelog")).filter((p) => !p.data.draft);
const totalPosts = allBlogPosts.length;
const totalChangelogs = allChangelog.length;

// Blog stats — computed from the actual content collection.
// Words and reading time sum across every published post body (stripping MDX
// frontmatter and JSX for a rough word count).
const WORDS_PER_MINUTE = 220;
const wordsWritten = allBlogPosts.reduce((sum, post) => {
  const text = (post.body ?? "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ");
  return sum + text.trim().split(" ").filter(Boolean).length;
}, 0);
const readingMinutes = Math.max(1, Math.round(wordsWritten / WORDS_PER_MINUTE));
const readingTime = readingMinutes >= 60
  ? `${Math.floor(readingMinutes / 60)}h ${readingMinutes % 60}m`
  : `${readingMinutes}m`;
const totalArticles = totalPosts;
// Coffee cups are now dynamic — calculated from GitHub commit intensity
// in the CoffeeCupsReact island (fetches /api/stats/github).

// Categories pulled from published post frontmatter. Empty when there's no content yet.
const categoryCounts = new Map<string, number>();
for (const post of allBlogPosts) {
  for (const cat of post.data.categories || []) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
}
const categories = Array.from(categoryCounts.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);
const maxCategoryCount = categories.length > 0 ? Math.max(...categories.map((c) => c.count)) : 1;

const barColors = [
  "bg-purple-500",
  "bg-indigo-500",
  "bg-blue-500",
  "bg-cyan-500",
  "bg-teal-500",
  "bg-emerald-500",
];

// Engagement data — site views are fetched client-side via SiteViewsCardReact
// hitting /api/stats/views. Community messages count is live from Supabase.
// Reactions are now live via ReactionsStatsCardReact (fetches /api/reactions).
const communityMessages = await getWallMessageCount();
const changelogUpdates = totalChangelogs;

// Days since this portfolio (v2) launched
const REVAMP_DATE = new Date("2026-04-01");
const now = new Date();
const diffTime = now.getTime() - REVAMP_DATE.getTime();
const daysSinceRevamp = Math.max(0, Math.floor(diffTime / (1000 * 60 * 60 * 24)));

// GitHub, PyPI, and HuggingFace stats are now fetched dynamically via
// React islands (GitHubStatsReact, PyPIStatsReact) hitting /api/stats/*
// endpoints. No build-time API calls needed — data updates without redeploys.

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// Changelog timeline — most recent 8 entries from the actual collection.
const sortedChangelog = [...allChangelog].sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const shortDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" });
const changelogEntries = sortedChangelog.slice(0, 8).map((c) => c.data.title);
const changelogDates = sortedChangelog.slice(0, 8).map((c) => shortDate.format(c.data.publishedAt));

// Formatted launch date for display.
const longDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" });
const revampDateLabel = longDate.format(REVAMP_DATE);
---

<Layout title="Stats | Kostas Georgiou">
  <div class="mt-14 space-y-12 pb-16 md:mt-16 md:space-y-16">
    <!-- Hero -->
    <GridWrapper>
      <PageHeader
        eyebrow="Stats"
        title="A peek behind the curtain"
        subtitle="Numbers, metrics, and fun facts about this little corner of the internet. Updated in real-time."
      />
    </GridWrapper>

    <!-- Blog Stats Section -->
    <section>
      <GridWrapper>
        <SectionEyebrow
          eyebrow="Writing"
          title="Blog stats"
          subtitle="Content creation metrics and popular articles."
        />
        <div class="space-y-2">
          <!-- Row 1: 4 small stat cards, equal width -->
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Total articles -->
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Total articles</h2>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">
                  <span class="count-up" data-target={totalArticles}>0</span>
                </p>
              </div>
            </div>

            <!-- Words written -->
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Words written</h2>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">
                  <span class="count-up" data-target={wordsWritten}>0</span>
                </p>
              </div>
            </div>

            <!-- Reading time -->
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Reading time</h2>
                <p class="mt-auto text-3xl font-semibold tracking-tight text-purple-primary">{readingTime}</p>
              </div>
            </div>

            <!-- Coffee consumed — dynamic, based on commit intensity -->
            <CoffeeCupsReact client:load />
          </div>

          <!-- Row 2: two medium "list" cards side by side -->
          <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
            <TopArticlesCardReact mode="views" client:load />
            <TopArticlesCardReact mode="reactions" client:load />
          </div>

          <!-- Row 3: Categories full-width (hidden until there are at least 3 categories) -->
          {categories.length >= 3 && (
            <div class="grid grid-cols-1 gap-2">
              <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
                <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
                <div class="relative z-20 flex h-full flex-col">
                  <h2 class="mb-2 font-medium text-text-primary">Categories</h2>
                  <p class="mb-4 text-sm text-text-secondary">Articles by topic</p>
                  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    {categories.map((category, index) => {
                      const percentage = (category.count / maxCategoryCount) * 100;
                      const color = barColors[index % barColors.length];
                      return (
                        <div>
                          <div class="mb-1 flex items-center justify-between">
                            <span class="truncate text-xs font-medium text-text-secondary">{category.name}</span>
                            <span class="ml-2 shrink-0 text-xs font-semibold tabular-nums text-text-tertiary">{category.count}</span>
                          </div>
                          <div class="relative h-3 w-full overflow-hidden rounded-full bg-border-primary/30">
                            <div
                              class:list={["bar-animate absolute inset-y-0 left-0 origin-left rounded-full", color]}
                              data-width={`${percentage}%`}
                              style="width: 0%;"
                            ></div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </GridWrapper>
    </section>

    <!-- Engagement Section -->
    <section>
      <GridWrapper>
        <SectionEyebrow
          eyebrow="Engagement"
          title="Activity & community"
          subtitle="Reactions, messages, and site activity."
        />
        <div class="grid grid-cols-1 gap-2 md:grid-cols-12">
          <!-- Site Views — React island that fetches /api/stats/views on mount -->
          <div class="md:col-span-3">
            <SiteViewsCardReact client:load />
          </div>

          <!-- Reaction Breakdown — live from Supabase (spans 2 rows) -->
          <div class="md:col-span-5 md:row-span-2">
            <ReactionsStatsCardReact client:load />
          </div>

          <!-- Community Messages -->
          <div class="md:col-span-4">
            <div class="group relative flex h-full min-h-[340px] flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <!-- Dot pattern bg -->
              <div class="absolute inset-0 bg-[radial-gradient(rgb(var(--color-border-primary)/0.4)_1px,transparent_2px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
              <div class="pointer-events-none absolute inset-0 z-30 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

              <!-- Stacked cards -->
              <div class="absolute inset-0 flex items-center justify-center pb-16">
                <div class="relative h-32 w-40">
                  <!-- Card 1 (back-left) -->
                  <svg class="absolute left-1/2 top-1/2 w-36" style="z-index: 1; transform: translate(calc(-50% + -15px), calc(-50% + 4px)) rotate(-9.6deg) scale(0.96); transform-origin: center;" viewBox="-15 -15 160 155" fill="none">
                    <defs>
                      <linearGradient id="cg1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#90D2AA"></stop><stop offset="100%" stop-color="#FEFFB4"></stop></linearGradient>
                      <filter id="cs1" x="-20%" y="-20%" width="150%" height="150%"><feDropShadow dx="4" dy="4" stdDeviation="8" flood-opacity="0.15"></feDropShadow></filter>
                    </defs>
                    <g filter="url(#cs1)"><rect width="120" height="115" x="5" y="5" rx="8" fill="#F7F7F8"></rect></g>
                    <rect x="10" y="10" width="110" height="90" rx="4" fill="url(#cg1)" opacity="0.85"></rect>
                    <circle cx="85" cy="35" r="25" fill="white" opacity="0.3"></circle>
                    <circle cx="40" cy="60" r="18" fill="white" opacity="0.2"></circle>
                    <rect x="25" y="35" width="50" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <rect x="25" y="50" width="35" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <circle cx="26" cy="110" r="7" fill="#D1D5DB"></circle>
                    <rect x="40" y="106" width="50" height="7" rx="3" fill="#E5E7EB"></rect>
                  </svg>
                  <!-- Card 2 (center) -->
                  <svg class="absolute left-1/2 top-1/2 w-36" style="z-index: 3; transform: translate(-50%, -50%) rotate(0deg) scale(1); transform-origin: center;" viewBox="-15 -15 160 155" fill="none">
                    <defs>
                      <linearGradient id="cg2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#C48EFF"></stop><stop offset="100%" stop-color="#FCCEED"></stop></linearGradient>
                      <filter id="cs2" x="-20%" y="-20%" width="150%" height="150%"><feDropShadow dx="4" dy="4" stdDeviation="8" flood-opacity="0.15"></feDropShadow></filter>
                    </defs>
                    <g filter="url(#cs2)"><rect width="120" height="115" x="5" y="5" rx="8" fill="#F7F7F8"></rect></g>
                    <rect x="10" y="10" width="110" height="90" rx="4" fill="url(#cg2)" opacity="0.85"></rect>
                    <circle cx="85" cy="35" r="25" fill="white" opacity="0.3"></circle>
                    <circle cx="40" cy="60" r="18" fill="white" opacity="0.2"></circle>
                    <rect x="25" y="35" width="50" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <rect x="25" y="50" width="35" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <circle cx="26" cy="110" r="7" fill="#D1D5DB"></circle>
                    <rect x="40" y="106" width="50" height="7" rx="3" fill="#E5E7EB"></rect>
                  </svg>
                  <!-- Card 3 (back-right) -->
                  <svg class="absolute left-1/2 top-1/2 w-36" style="z-index: 2; transform: translate(calc(-50% + 15px), calc(-50% + 4px)) rotate(9.6deg) scale(0.98); transform-origin: center;" viewBox="-15 -15 160 155" fill="none">
                    <defs>
                      <linearGradient id="cg3" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#81E0CA"></stop><stop offset="100%" stop-color="#E9F2FE"></stop></linearGradient>
                      <filter id="cs3" x="-20%" y="-20%" width="150%" height="150%"><feDropShadow dx="4" dy="4" stdDeviation="8" flood-opacity="0.15"></feDropShadow></filter>
                    </defs>
                    <g filter="url(#cs3)"><rect width="120" height="115" x="5" y="5" rx="8" fill="#F7F7F8"></rect></g>
                    <rect x="10" y="10" width="110" height="90" rx="4" fill="url(#cg3)" opacity="0.85"></rect>
                    <circle cx="85" cy="35" r="25" fill="white" opacity="0.3"></circle>
                    <circle cx="40" cy="60" r="18" fill="white" opacity="0.2"></circle>
                    <rect x="25" y="35" width="50" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <rect x="25" y="50" width="35" height="6" rx="3" fill="white" opacity="0.5"></rect>
                    <circle cx="26" cy="110" r="7" fill="#D1D5DB"></circle>
                    <rect x="40" y="106" width="50" height="7" rx="3" fill="#E5E7EB"></rect>
                  </svg>
                </div>
              </div>

              <div class="relative z-20 mt-auto">
                <h2 class="mb-1 font-medium text-text-primary">Community messages</h2>
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-bold tabular-nums tracking-tight text-purple-primary">
                    <span class="count-up" data-target={communityMessages}>0</span>
                  </span>
                  <span class="text-sm text-text-tertiary">messages</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Changelog Updates -->
          <div class="md:col-span-3">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-30 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

              <!-- Central vertical timeline -->
              <div class="border-px absolute left-1/2 top-0 h-full w-2 -translate-x-1/2 transform border-x border-[#A5AEB8]/10 bg-[#D6DADE]/35"></div>

              <!-- Timeline entries -->
              <div class="relative flex-1">
                <div class="absolute left-0 right-0 top-0">
                  {changelogEntries.map((title, index) => (
                    <div
                      class="absolute"
                      style={`top: ${-5 + index * 42}px; ${index % 2 === 1 ? "left: calc(50% + 6px);" : "right: calc(50% + 6px);"}`}
                    >
                      <span
                        class:list={["absolute top-[14px] h-px w-[6px] bg-border-primary", index % 2 === 1 ? "left-[-6px]" : "right-[-6px]"]}
                      ></span>
                      <div class="z-10 inline-block w-[100px] space-y-px rounded-lg border border-border-primary bg-white px-2 py-1.5 text-xs shadow-sm">
                        <p class="overflow-hidden text-ellipsis whitespace-nowrap font-semibold text-text-secondary">{title}</p>
                        <time class="text-[9px] text-text-tertiary">{changelogDates[index]}</time>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Gradients -->
              <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-10 bg-gradient-to-b from-bg-primary to-transparent transition-colors group-hover:from-white"></div>
              <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-32 bg-gradient-to-t from-bg-primary via-bg-primary/75 to-transparent transition-colors group-hover:from-white group-hover:via-white/75"></div>

              <div class="relative z-20 mt-auto">
                <h2 class="mb-1 font-medium text-text-primary">Changelog</h2>
                <div class="flex items-baseline gap-2">
                  <span class="text-2xl font-bold tabular-nums tracking-tight text-purple-primary">
                    <span class="count-up" data-target={changelogUpdates}>0</span>
                  </span>
                  <span class="text-sm text-text-tertiary">updates</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Days Since Revamp -->
          <div class="md:col-span-4">
            <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-primary bg-bg-primary p-6 transition-all duration-300 hover:border-indigo-400 hover:bg-white">
              <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-gradient-to-tl from-indigo-400/20 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <!-- Decorative calendar -->
              <div class="absolute -bottom-2 -right-2 text-[100px] leading-none opacity-10" style="transform: rotate(-5deg);">&#128197;</div>
              <div class="relative z-20 flex h-full flex-col">
                <h2 class="mb-2 font-medium text-text-primary">Site age</h2>
                <p class="text-sm text-text-secondary">Since last revamp</p>
                <div class="mt-auto">
                  <div class="flex items-baseline gap-2">
                    <span class="text-5xl font-bold tracking-tight text-purple-primary">
                      <span class="count-up" data-target={daysSinceRevamp}>0</span>
                    </span>
                    <span class="text-lg text-text-secondary">days</span>
                  </div>
                  <p class="mt-2 text-xs text-text-tertiary">
                    Launched {revampDateLabel}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- CV downloads — Supabase-backed counter from /api/cv. Full width
               since it's a top-level engagement signal. -->
          <div class="md:col-span-12">
            <CvDownloadsCardReact client:load />
          </div>

          <!-- Comments — live from Supabase. Full width on its own row. -->
          <div class="md:col-span-12">
            <CommentsStatsCardReact client:load />
          </div>

          <!-- Engagement geography — countries that have commented/reacted/messaged -->
          <div class="md:col-span-12">
            <EngagementCountriesCardReact client:load />
          </div>
        </div>
      </GridWrapper>
    </section>

    <!-- Traffic Section — live from Umami Cloud -->
    <section>
      <GridWrapper>
        <SectionEyebrow
          eyebrow="Traffic"
          title="Visitors and referrers"
          subtitle="Live from Umami."
        />
        <UmamiStatsReact client:load />
      </GridWrapper>
    </section>

    <!-- GitHub Section — dynamic via React island -->
    <section>
      <GridWrapper>
        <SectionEyebrow
          eyebrow="GitHub"
          title="Contributions & repos"
          subtitle="Open source activity and repository stats."
        />
        <GitHubStatsReact client:load />
      </GridWrapper>
    </section>

    <!-- Open Source Section — dynamic via React island -->
    <section>
      <GridWrapper>
        <SectionEyebrow
          eyebrow="Open source"
          title="Packages & downloads"
          subtitle="Live download counts from PyPI and HuggingFace."
        />
        <PyPIStatsReact client:load />
      </GridWrapper>
    </section>
  </div>
</Layout>

<script>
  // Animated count-up on scroll into view
  function animateCountUp() {
    const counters = document.querySelectorAll('.count-up');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.target || '0', 10);
          if (target === 0) {
            el.textContent = '0';
            observer.unobserve(el);
            return;
          }
          const duration = 1500;
          const startTime = performance.now();

          function update(currentTime: number) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = Math.floor(eased * target);
            el.textContent = current.toLocaleString();
            if (progress < 1) {
              requestAnimationFrame(update);
            } else {
              el.textContent = target.toLocaleString();
            }
          }

          requestAnimationFrame(update);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.2 });

    counters.forEach((counter) => observer.observe(counter));
  }

  // Animated bar widths on scroll into view
  function animateBars() {
    const bars = document.querySelectorAll('.bar-animate');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const targetWidth = el.dataset.width || '0%';
          setTimeout(() => {
            el.style.transition = 'width 0.8s ease-out';
            el.style.width = targetWidth;
          }, 100);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.2 });

    bars.forEach((bar) => observer.observe(bar));
  }

  // Run on page load
  animateCountUp();
  animateBars();

  // Also run after View Transitions (Astro)
  document.addEventListener('astro:page-load', () => {
    animateCountUp();
    animateBars();
  });
</script>
