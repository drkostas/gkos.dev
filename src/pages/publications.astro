---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import PageHeader from "@/components/PageHeader.astro";
import PubList from "@/components/PubList.astro";
import { PeopleGridBentoReact } from "@/components/PeopleGridBentoReact";
import { RSSSubscribeCard } from "@/components/RSSSubscribeCard";
import { ContactCompactReact } from "@/components/ContactCompactReact";
import { COAUTHORS } from "@/data/coauthors";
import { siteMetadata } from "@/data/siteMetadata";

const coauthorPeople = COAUTHORS.map((c) => ({
  name: c.name,
  role: c.role,
  url: c.url,
  badge: c.papersTogether ? `${c.papersTogether} paper${c.papersTogether === 1 ? "" : "s"}` : undefined,
}));
---

<Layout title="Publications | Kostas Georgiou">
  <div class="mt-14 space-y-12 md:mt-16">
    <GridWrapper>
      <PageHeader
        title="Things I've published"
        subtitle="Mostly self-supervised learning, LLMs, computer vision, and remote sensing. A bit of medical AI too."
      />
    </GridWrapper>

    <GridWrapper><PubList /></GridWrapper>

    <GridWrapper>
      <div class="grid gap-4 md:grid-cols-2 md:items-stretch">
        <div class="flex flex-col gap-4">
          <ContactCompactReact client:visible />
          <RSSSubscribeCard client:visible siteUrl={siteMetadata.siteUrl} />
        </div>
        <PeopleGridBentoReact
          client:visible
          heading="Frequent co-authors"
          subhead="People I've published with"
          people={coauthorPeople}
        />
      </div>
    </GridWrapper>
  </div>
</Layout>
