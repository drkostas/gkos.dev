---
import Layout from "@/layouts/Layout.astro";
import { AnimatedProfilePicture } from "@/components/ProfilePicture";
import { AnimatedText } from "@/components/AnimatedText";
import { PhotoGallery } from "@/components/PhotoGallery";
import { AnimatedMobilePhotos } from "@/components/AnimatedMobilePhotos";
import GridWrapper from "@/components/GridWrapper.astro";
import AboutMeBento from "@/components/AboutMeBento.astro";
import { ConnectionsBentoReact } from "@/components/ConnectionsBentoReact";
import ToolboxBento from "@/components/ToolboxBento.astro";
import CalendarBento from "@/components/CalendarBento.astro";
import { FeaturedBlogCardReact } from "@/components/FeaturedBlogCardReact";
import ChangelogBento from "@/components/ChangelogBento.astro";
import { SpeakingBentoReact } from "@/components/SpeakingBentoReact";
import { CommunityWallBentoReact } from "@/components/CommunityWallBentoReact";
import { ExploreModeBannerReact } from "@/components/ExploreModeBannerReact";
import { getCollection } from "astro:content";

// Pull the 3 most recent published posts from the actual collection.
// When the collection is empty, this is an empty array and the Blog section
// falls through to the empty state.
const featuredArticles = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3)
  .map((post) => ({
    slug: post.id,
    imageName: post.data.imageName,
    title: post.data.title,
    summary: post.data.summary,
  }));
---

{/* Animation delays matching Kostas's */}
<Layout>
  <section>
    <AnimatedProfilePicture delay={0} client:load />
    <div class="mt-6 space-y-10 md:mt-0 md:space-y-16">
      <section>
        <div class="relative text-balance">
          <GridWrapper>
            <AnimatedText
              as="h1"
              delay={0.3}
              className="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]"
              client:load
            >
              Hey, I'm Kostas! <br /> ML Engineer, Researcher and Builder.
            </AnimatedText>
          </GridWrapper>
          <GridWrapper>
            <div class="mt-4 text-center md:mt-8">
              <AnimatedText
                as="p"
                delay={0.4}
                className="leading-8 text-text-secondary"
                client:load
              >
                I'm a PhD ML Engineer at Amazon who ships AI products, publishes research at NeurIPS and WACV, and contributes to open source with 8,300+ GitHub followers.
              </AnimatedText>
            </div>
          </GridWrapper>
        </div>
        <div>
          <div class="relative hidden h-fit w-full items-center justify-center lg:flex">
            <PhotoGallery animationDelay={0.5} client:load />
          </div>
          <AnimatedMobilePhotos delay={0.5} client:load />
        </div>
      </section>

      <!-- About Section -->
      <section class="relative space-y-10 md:space-y-16">
        <div class="space-y-4">
          <GridWrapper>
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
              <span>About</span>
            </div>
          </GridWrapper>
          <GridWrapper>
            <h2 class="mx-auto max-w-lg text-balance text-center text-3xl font-medium leading-10 tracking-tight text-text-primary md:text-4xl">
              A quick snapshot of what I do
            </h2>
          </GridWrapper>
        </div>

        <GridWrapper>
          <div class="grid grid-cols-1 gap-2 md:grid-cols-12 lg:grid-rows-[14]">
            <div class="col-span-1 md:col-span-5 lg:col-span-5 lg:row-span-6">
              <AboutMeBento />
            </div>
            <div class="md:col-span-12 lg:col-span-7 lg:row-span-8">
              <ConnectionsBentoReact variant="workbench" linkTo="/workbench" client:visible />
            </div>
            <div class="md:col-span-7 md:row-start-1 lg:col-span-5 lg:row-span-7">
              <ToolboxBento />
            </div>
            <div class="md:col-span-12 lg:col-span-7 lg:row-span-5">
              <CalendarBento />
            </div>
          </div>
        </GridWrapper>
      </section>

      <!-- Blog Section -->
      <section class="relative space-y-10 md:space-y-16">
        <div class="relative space-y-4 text-balance">
          <GridWrapper>
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
              <span>Blog</span>
            </div>
          </GridWrapper>
          <GridWrapper>
            <h2 class="mx-auto max-w-lg text-center text-3xl font-medium leading-10 tracking-tighter text-text-primary md:text-4xl">
              I like sharing my experiments and knowledge with others
            </h2>
          </GridWrapper>
        </div>

        <div class="z-10">
          <GridWrapper>
            {featuredArticles.length > 0 ? (
              <ul class="z-50 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
                {featuredArticles.map((post, index) => (
                  <FeaturedBlogCardReact
                    slug={post.slug}
                    imageName={post.imageName}
                    title={post.title}
                    summary={post.summary}
                    direction={index % 2 === 0 ? "left" : "right"}
                    client:visible
                  />
                ))}
              </ul>
            ) : (
              <div class="mx-auto max-w-md rounded-2xl border border-dashed border-border-primary bg-bg-primary p-8 text-center">
                <p class="text-text-secondary">
                  New posts are brewing. Check back soon or follow along on{" "}
                  <a href="https://github.com/drkostas" class="font-medium text-indigo-600">GitHub</a>.
                </p>
              </div>
            )}
          </GridWrapper>
        </div>
      </section>

      <!-- My Site Section -->
      <section class="relative space-y-10 md:space-y-16">
        <div class="space-y-4 text-balance">
          <GridWrapper>
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
              <span>My Site</span>
            </div>
          </GridWrapper>
          <GridWrapper>
            <h2 class="text-center text-3xl font-medium leading-10 tracking-tighter text-text-primary md:mx-auto md:max-w-lg md:text-4xl">
              My site is a playful sandbox. Explore, experiment, and say hello
            </h2>
          </GridWrapper>
        </div>

        <GridWrapper>
          <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
            <span class="col-span-1 h-[276px] block md:hidden lg:block">
              <ChangelogBento />
            </span>
            <SpeakingBentoReact client:visible />
            <CommunityWallBentoReact client:visible />
          </div>
        </GridWrapper>
      </section>

      <!-- Explore mode banner -->
      <section>
        <ExploreModeBannerReact client:load />
      </section>
    </div>
  </section>
</Layout>
