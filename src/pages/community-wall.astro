---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { CommunityWallReact } from "@/components/CommunityWallReact";
---

<Layout title="Community Wall | Kostas Georgiou">
  <!-- Page Header -->
  <div class="mt-14 pb-8 md:mt-16">
    <GridWrapper>
      <div class="space-y-6">
        <div class="space-y-3">
          <h1 class="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
            Community Wall
          </h1>
          <p class="mx-auto max-w-2xl text-center text-lg text-text-secondary">
            Leave a message, share your thoughts, or just say hello.
          </p>
          <p class="mx-auto hidden max-w-2xl text-center text-sm text-text-tertiary md:block">
            Click and drag to explore all the messages scattered across the canvas.
          </p>
        </div>
      </div>
    </GridWrapper>
  </div>

  <!-- Canvas (handles modal + dragging in one React island) -->
  <GridWrapper class="pb-16">
    <CommunityWallReact client:load />
  </GridWrapper>
</Layout>
