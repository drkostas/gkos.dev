---
/* About page.
 *
 * Layout shape (top → bottom):
 *   - Hero: title + subtitle
 *   - Work history (Resume widget with the rail timeline)
 *   - Hinge: "Want the story behind it?"
 *   - 8-section narrative with the dynamic narrative curve weaving around photos
 *   - Bento section ("A bit more about me, in widgets") — Inspirations card
 *   - Contact card
 *
 * Shared partials live at src/components/about/.
 * Dynamic narrative curve at src/components/AboutNarrativeTrack.tsx.
 */
import Layout from "@/layouts/Layout.astro";
import { AboutNarrativeTrack } from "@/components/AboutNarrativeTrack";
import HeroAbout from "@/components/about/HeroAbout.astro";
import NarrativeSection from "@/components/about/NarrativeSection.astro";
import ResumeSection from "@/components/about/ResumeSection.astro";
import BentoBottom from "@/components/about/BentoBottom.astro";
---
<Layout title="About | Kostas Georgiou">
  <div class="relative mt-14">
    <div class="relative space-y-10 md:space-y-16">
      <HeroAbout tldr={false} />
      <ResumeSection eyebrow="Work history" heading="Where I've been." />
      <!-- Hinge pill -->
      <div class="relative flex flex-col items-center py-4">
        <div class="rounded-full border border-border-primary bg-bg-secondary/40 px-5 py-2 text-sm font-medium text-text-primary">
          Want the story behind it?
        </div>
      </div>
      <div class="relative space-y-8 text-center">
        <div class="relative h-fit w-full overflow-hidden" data-narrative-wrapper="true">
          <AboutNarrativeTrack client:load />
          <NarrativeSection title="Origins" body="I grew up in Greece. I did my Integrated Master's in Computer Science &amp; Engineering at the University of Patras and graduated in 2019. The final year was spent on a research project, a distributed Girvan-Newman variant for community detection in social graphs. That work doubled as my master's thesis and became my first published paper." photo="/blog/how-i-got-here/patras-graduation.jpg" alt="Patras" side="left" rotate={-8} padY="py-12 lg:py-32 lg:pb-20 xl:py-32" focal="center 35%" />
          <NarrativeSection title="The pre-PhD years" body="During my master's I spent a year in the UK as a Software Developer at Global Voices, mostly Python services for a translation CMS used by a few hundred translators. Then back to Athens at Performance Technologies as a Data Engineer. The main thing there was a terabyte-scale data replication for OTE (Greece's biggest telco): replication times went from days down to minutes. A bit of ML too: an order-fulfillment-time model that came in 34% better than the baseline they had." photo="/kostas_neurips_square.jpg" alt="Kostas" side="right" rotate={8} focal="right center" />
          <NarrativeSection title="Start of PhD" body="In 2021 I moved from Athens to Knoxville to start my PhD at UTK under Dr. Hairong Qi at the Bredesen Center. The research direction was mostly self-supervised learning, LLM security, and a bit of trustworthy AI." photo="/blog/how-i-got-here/utk-campus-720.jpg" alt="UTK campus" side="left" rotate={-8} focal="center" />
          <NarrativeSection title="XPensAI" body="In 2024 I co-founded XPensAI, an AI-powered SaaS for expense management. A small team, B2B customers, a lot of computer vision plumbing under the hood (receipt scanning, expense categorization, real-time analytics). 30+ businesses use it so far, and the receipt-scan accuracy is around 95%." photo="/kostas_speaking.jpg" alt="Kostas speaking" side="right" rotate={8} focal="center" />
          <NarrativeSection title="Amazon" body="Summer 2025 I interned at Amazon as an Applied Scientist on multi-agent LLM systems for Alexa. The main thing was a framework converting natural language to executable code: 82% functional success on smart home automations and 87.6% on MBPP. The other half was an impossibility detector that flagged unfeasible requests at ~93% (about 4.5x over the baseline they had), which kept the model from hallucinating code for things it couldn't actually do." photo="/blog/how-i-got-here/amazon-backdrop.jpg" alt="Amazon" side="left" rotate={-8} focal="left center" />
          <NarrativeSection title="FleetSmart.ai" body="Early 2026 I took on FleetSmart.ai, one of my main freelance contract projects: an AI Engineer role on a maritime logistics platform. The system helps commercial fleet operators decide where to position their vessels next: a multi-objective optimization engine ranks vessel-opportunity matches across cost, speed, risk, and environmental targets, running on 9+ real-time data pipelines (AIS vessel tracking, Baltic Exchange bunker prices, freight curves, port congestion, news sentiment) and multi-provider LLM tool calls (Gemini, OpenAI, Claude via MCP). Plus a fleet KPI engine for benchmarking, voyage simulation for what-if planning, and post-voyage cost feedback loops." photo="/kostas_igarss_portrait.jpg" alt="FleetSmart" side="right" rotate={8} focal="center" />
          <NarrativeSection title="PhD graduation" body="May 2026: defended after five years. The two main research lines were Cross-Scale MAE for remote sensing and MEDiC / ExPLoRe for broader image modeling. A few papers along the way and a fellowship at the Bredesen Center." photo="/kostas_poster_portrait.jpg" alt="PhD defense" side="left" rotate={-8} focal="center" />
          <NarrativeSection title="Weekends and waves" body="When I'm not at the keyboard I'm usually outside. Surfing when I can, walking somewhere new, losing at board games. Originally from Greece, currently in the US." photo="/kostas_photo_2.jpg" alt="Outside" side="right" rotate={8} padY="xl:py-24" focal="center" />
        </div>
      </div>
      <BentoBottom />
    </div>
  </div>
</Layout>
