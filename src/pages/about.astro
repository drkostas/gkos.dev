---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { NewsletterSignUpReact } from "@/components/NewsletterSignUpReact";
import Resume from "@/components/Resume.astro";
import { ConnectionsBentoReact } from "@/components/ConnectionsBentoReact";
import { CurrentlyPlayingBentoReact } from "@/components/CurrentlyPlayingBentoReact";
import { ScrapbookBentoReact } from "@/components/ScrapbookBentoReact";
import { CurrentlyReadingBentoReact } from "@/components/CurrentlyReadingBentoReact";
import { StatsBentoReact } from "@/components/StatsBentoReact";
import { AboutTrackPattern } from "@/components/AboutTrackPattern";
import { TimelineReact } from "@/components/TimelineReact";
import { Photo } from "@/components/Photo";

// Time-of-day greeting (matches Braydon's getTimeOfDayGreeting util)
const hour = new Date().getHours();
let timeOfDayGreeting = "Good morning";
if (hour >= 12 && hour < 18) timeOfDayGreeting = "Good afternoon";
else if (hour >= 18 || hour < 5) timeOfDayGreeting = "Good evening";

// Reusable ShadowBox + photo snippet
const shadowBoxWidth = 188;
const shadowBoxHeight = 278;
---

<Layout title="About | Braydon Coyer">
  <div class="relative mt-14">
    <div class="relative space-y-10 md:space-y-16">
      <!-- Title -->
      <GridWrapper class="space-y-12">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-around lg:px-24">
          <div class="order-2 mx-auto max-w-lg lg:order-1 lg:m-0 lg:max-w-3xl lg:pr-12">
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary lg:text-left">
              <span>{timeOfDayGreeting}</span>
            </div>
            <h1 class="mx-auto max-w-2xl text-balance text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-5xl lg:text-left lg:text-6xl lg:leading-[64px]">
              I'm Braydon, a creative frontend engineer.
            </h1>
          </div>
          <div class="order-1 my-12 flex-shrink-0 lg:order-2 lg:my-0">
            <div class="relative mx-auto w-full max-w-[400px]">
              <div class="relative grid grid-cols-3">
                <div class="relative z-20 -translate-y-2">
                  <Photo width={140} height={140} src="/braydon_speaking_photo.jpeg" alt="Braydon Coyer" direction="left" client:visible />
                </div>
                <div class="relative z-30">
                  <Photo width={140} height={140} src="/braydon_headshot_1.jpeg" alt="Braydon Coyer" direction="right" client:visible />
                </div>
                <div class="relative z-20 translate-y-4">
                  <Photo width={140} height={140} src="/braydon_headshot_3.jpg" alt="Braydon Coyer" direction="left" client:visible />
                </div>
              </div>
            </div>
          </div>
        </div>
      </GridWrapper>

      <span class="absolute left-1/2 top-40 -translate-y-1/2 translate-x-1/2">
        <span class="absolute left-1/2 h-px w-full -translate-x-1/2 transform bg-border-primary/50"></span>
      </span>

      <!-- About narrative -->
      <div class="relative space-y-8 text-center">
        <div class="space-y-4">
          <GridWrapper>
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
              <span>About</span>
            </div>
          </GridWrapper>
          <GridWrapper>
            <h2 class="mx-auto max-w-xl text-balance text-3xl font-medium leading-[40px] tracking-tighter text-text-primary">
              Here's a quick intro about me and what I love to do
            </h2>
          </GridWrapper>
        </div>
        <div class="relative h-fit w-full overflow-hidden">
          <div class="absolute left-0 top-0 w-full md:left-4 lg:left-[355px] xl:left-[455px]">
            <AboutTrackPattern client:visible />
          </div>

          <!-- Section 1: Programming origins -->
          <div class="grid grid-cols-1 gap-8 py-12 pr-12 lg:grid-cols-2 lg:items-center lg:justify-between lg:py-32 lg:pb-20 xl:py-32">
            <div class="flex flex-col items-center text-left lg:order-2 lg:items-start">
              <div class="mb-8 lg:hidden">
                <div class="relative mx-auto w-fit">
                  <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                    <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                  </div>
                  <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[-8deg] rounded-lg object-cover shadow" src="/knights_kwest.jpeg" alt="A headshot" />
                </div>
              </div>
              <h2 class="mb-6 w-full text-balance text-3xl font-medium leading-[40px] tracking-tighter text-text-primary">
                My programming origins
              </h2>
              <p class="mb-6 text-base leading-8 text-text-secondary">
                When Apple unveiled the first iPad with its beautiful 1024x768 display, I knew I had to create for it. I taught myself mobile development while freelancing, and soon I was shipping iOS and Android apps. One of my games even climbed above Angry Birds in the charts for a while—which still makes me smile when I think about it.
              </p>
            </div>
            <div class="hidden lg:order-1 lg:block">
              <div class="relative mx-auto w-fit">
                <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                  <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                </div>
                <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[-8deg] rounded-lg object-cover shadow" src="/knights_kwest.jpeg" alt="A headshot" />
              </div>
            </div>
          </div>

          <!-- Section 2: Finding Way to Web -->
          <div class="grid grid-cols-1 gap-8 py-24 lg:grid-cols-2 lg:items-center lg:justify-between lg:pl-12">
            <div class="flex flex-col items-center text-left lg:items-start">
              <div class="mb-8 lg:hidden">
                <div class="relative mx-auto w-fit">
                  <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                    <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                  </div>
                  <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[-8deg] rounded-lg object-cover shadow" src="/c3_speaker_head.png" alt="Speaking at C3 Conf!" />
                </div>
              </div>
              <h2 class="mb-6 w-full text-balance text-3xl font-medium leading-[40px] tracking-tighter text-text-primary">
                Finding My Way to Web
              </h2>
              <p class="mb-6 text-base leading-8 text-text-secondary">
                Despite my love for mobile development, the web kept calling my name. With my eye for design, frontend felt like the perfect playground. I dove into HTML, CSS, and JavaScript—with React in 2016 becoming my game-changer. A few months later and I had landed my first full-time web dev role and never looked back.
              </p>
            </div>
            <div class="hidden lg:block">
              <div class="relative mx-auto w-fit">
                <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                  <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                </div>
                <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[8deg] rounded-lg object-cover shadow" src="/braydon_headshot_3.jpg" alt="Speaking at C3 Conf!" />
              </div>
            </div>
          </div>

          <!-- Section 3: Life Beyond Code -->
          <div class="grid grid-cols-1 gap-8 pr-12 lg:grid-cols-2 lg:items-center lg:justify-between xl:py-24">
            <div class="flex flex-col items-center text-left lg:order-2 lg:items-start">
              <div class="mb-8 lg:hidden">
                <div class="relative mx-auto w-fit">
                  <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                    <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                  </div>
                  <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[-8deg] rounded-lg object-cover shadow" src="/braydon_and_pj.jpeg" alt="A headshot" />
                </div>
              </div>
              <h2 class="mb-6 w-full text-balance text-3xl font-medium leading-[40px] tracking-tighter text-text-primary">
                Life Beyond Code
              </h2>
              <p class="mb-6 text-base leading-8 text-text-secondary">
                When I met PeggyJean, I knew pretty quickly she was the one. After proposing, we had grand wedding plans – until COVID happened. We pivoted (developer joke!) and had a small, intimate ceremony in 2020 that turned out more perfect than we could have imagined.
              </p>
              <p class="mb-6 text-base leading-8 text-text-secondary">
                Family has always been my center, and seeing ours grow has been life's greatest joy. Our daughter ElizaJane arrived in 2021, bringing endless wonder to our days, and little Renny joined our crew in 2023, completing our circle.
              </p>
            </div>
            <div class="hidden lg:block">
              <div class="relative mx-auto w-fit">
                <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                  <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                </div>
                <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[-8deg] rounded-lg object-cover shadow" src="/braydon_and_pj.jpeg" alt="A headshot" />
              </div>
            </div>
          </div>

          <!-- Section 4: These Days -->
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center lg:justify-between lg:py-32 lg:pl-12 xl:py-24">
            <div class="flex flex-col items-center text-left lg:items-start">
              <div class="mb-8 lg:hidden">
                <div class="relative mx-auto w-fit">
                  <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                    <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                  </div>
                  <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[8deg] rounded-lg object-cover shadow" src="/braydon_speaking_photo.jpeg" alt="A headshot" />
                </div>
              </div>
              <h2 class="mb-6 w-full text-balance text-3xl font-medium leading-[40px] tracking-tighter text-text-primary">
                These Days
              </h2>
              <p class="mb-6 text-base leading-8 text-text-secondary">
                Currently, I'm leading teams at LogicGate as a Senior Frontend Engineer where we're building some pretty awesome stuff. Speaking at tech conferences has become a regular part of my year.
              </p>
              <p class="mb-6 text-base leading-8 text-text-secondary">
                When I'm not working, you'll find me on creative coding side projects, writing for my blog, failing spectacularly at games with friends, or—best of all—hanging out with my family, usually with coffee nearby and dad jokes at the ready.
              </p>
            </div>
            <div class="hidden lg:block">
              <div class="relative mx-auto w-fit">
                <div class="rounded-[20px] border border-border-primary p-2" style={`width: ${shadowBoxWidth}px; height: ${shadowBoxHeight}px;`}>
                  <div class="grid h-full place-items-center rounded-xl border-2 border-[#A5AEB81F]/10 bg-[#EDEEF0]" style="box-shadow: 0px 2px 1.5px 0px #A5AEB852 inset;"></div>
                </div>
                <img class="absolute left-0 top-0 h-[270px] w-[180px] rotate-[8deg] rounded-lg object-cover shadow" src="/braydon_speaking_photo.jpeg" alt="A headshot" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Experience -->
      <div class="relative space-y-8 text-center">
        <div class="space-y-4">
          <GridWrapper>
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
              <span>Experience</span>
            </div>
          </GridWrapper>
          <GridWrapper>
            <h2 class="mx-auto max-w-lg text-balance text-3xl font-medium leading-[40px] tracking-tighter text-text-primary">
              My work history and achievements timeline.
            </h2>
          </GridWrapper>
        </div>
      </div>
      <div class="space-y-16">
        <GridWrapper>
          <Resume>
            <TimelineReact slot="timeline" avatarUrl="/braydon_headshot_1.jpeg" client:visible />
          </Resume>
        </GridWrapper>
      </div>

      <!-- More / Bento grid -->
      <section class="relative space-y-16">
        <div class="space-y-4">
          <GridWrapper>
            <div class="text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
              <span>More</span>
            </div>
          </GridWrapper>
          <GridWrapper>
            <h2 class="mx-auto max-w-lg text-balance text-center text-3xl font-medium leading-10 tracking-tight text-text-primary">
              Here's what sets me apart and makes me unique
            </h2>
          </GridWrapper>
        </div>

        <GridWrapper>
          <div class="grid grid-cols-1 gap-2 lg:grid-cols-12">
            <div class="lg:col-span-3 lg:row-span-6">
              <CurrentlyPlayingBentoReact client:visible />
            </div>
            <div class="hidden lg:col-span-7 lg:row-span-5 lg:block">
              <ScrapbookBentoReact client:visible />
            </div>
            <div class="hidden lg:col-span-2 lg:col-start-11 lg:row-span-10 lg:block lg:min-h-[50px]">
              <CurrentlyReadingBentoReact client:visible />
            </div>
            <div class="lg:col-span-7 lg:row-span-8">
              <ConnectionsBentoReact linkTo="/connections" client:visible />
            </div>
            <div class="lg:col-span-3 lg:row-span-4">
              <StatsBentoReact client:visible />
            </div>
          </div>
        </GridWrapper>
      </section>

      <NewsletterSignUpReact client:visible />
    </div>
  </div>
</Layout>
