---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";

interface Project {
  title: string;
  description: string;
  image: string;
  url: string;
}

const projects: Project[] = [
  {
    title: "Commit Your Code Conference Website",
    description:
      "A web development conference for charity, the Commit Your Code Conference website was designed and built by me using Figma, Next.js and Tailwind CSS.",
    image: "/projects/commit_your_code_project.jpeg",
    url: "https://www.commityourcode.com/",
  },
  {
    title: "Pomegradient",
    description:
      "Pomegradient is a web-based gradient solution that allows you to find, save and craft gradients with a creative community!",
    image: "/projects/pomegradient_project.jpeg",
    url: "https://www.pomegradient.com/",
  },
];
---

<Layout title="Projects | Kostas Georgiou">
  <div class="relative space-y-16">
    <GridWrapper>
      <h1 class="mx-auto mt-16 max-w-2xl text-balance text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
        A collection of my favorite works.
      </h1>
    </GridWrapper>

    <GridWrapper class="space-y-12">
      {projects.map((project) => (
        <div class="space-y-12">
          <GridWrapper class="px-10">
            <img src={project.image} alt={project.title} class="drama-shadow rounded-xl" />
          </GridWrapper>
          <GridWrapper class="px-10">
            <div class="max-w-2xl text-balance">
              <h2 class="mb-3 text-2xl font-medium leading-6 tracking-tight text-slate-900 md:leading-none">
                {project.title}
              </h2>
              <p class="mb-3 flex-grow text-base leading-6 text-text-secondary">
                {project.description}
              </p>
              <a
                class="inline-flex items-center text-sm font-medium text-indigo-600"
                href={project.url}
              >
                Visit {project.title}
                <svg
                  class="relative ml-2.5 mt-px overflow-visible"
                  width="3"
                  height="6"
                  viewBox="0 0 3 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M0 0L3 3L0 6"></path>
                </svg>
              </a>
            </div>
          </GridWrapper>
        </div>
      ))}
    </GridWrapper>
  </div>
</Layout>
