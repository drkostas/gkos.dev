---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { NewsletterSignUpReact } from "@/components/NewsletterSignUpReact";
import CodePlayground from "@/components/CodePlayground.astro";
import { getCollection, render } from "astro:content";

// Component map passed to MDX renderer for unknown components Braydon uses.
const mdxComponents = { CodePlayground };

const allChangelogItems = (await getCollection("changelog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title="Changelog | Braydon Coyer">
  <div class="w-full space-y-16">
    <div class="mx-auto text-balance pt-14 md:pt-16">
      <GridWrapper>
        <h1 class="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
          Here's what's new && exciting on my site.
        </h1>
      </GridWrapper>
    </div>

    <ul class="flex flex-col">
      {allChangelogItems.length > 0 ? (
        allChangelogItems.map(async (post) => {
          const { Content } = await render(post);
          const iso = post.data.publishedAt.toISOString();
          return (
            <li>
              <div class="grid h-full grid-cols-1 rounded-2xl md:grid-cols-12">
                <div class="col-span-2 col-start-1 hidden space-y-2 p-4 md:block">
                  <div class="font-mono text-sm leading-none text-text-secondary">
                    <time datetime={iso}>{formatDate(post.data.publishedAt)}</time>
                  </div>
                </div>
                <div class="col-start-3 col-end-4 hidden h-full border-x border-dashed border-border-primary md:block"></div>
                <div class="col-span-9 col-start-4 flex w-full flex-grow flex-col p-4">
                  <div class="mb-3 font-mono text-sm leading-none text-text-secondary md:hidden">
                    <time datetime={iso}>{formatDate(post.data.publishedAt)}</time>
                  </div>
                  <h2 class="mb-8 text-balance text-2xl font-medium leading-none tracking-tight text-text-primary">
                    {post.data.title}
                  </h2>
                  {post.data.imageName ? (
                    <img
                      class="drama-shadow mb-12 aspect-video rounded-xl object-cover"
                      src={`/${post.data.imageName}`}
                      alt=""
                    />
                  ) : null}
                  <div class="prose prose-lg max-w-none prose-p:mb-8 prose-p:leading-8 prose-p:text-text-secondary prose-a:text-indigo-600 prose-a:font-medium prose-a:no-underline hover:prose-a:underline prose-strong:font-medium prose-headings:tracking-tighter prose-headings:font-medium prose-li:text-text-secondary prose-li:leading-8">
                    <Content components={mdxComponents} />
                  </div>
                </div>
              </div>
              <div class="h-0 w-full border-t border-dashed border-border-primary"></div>
            </li>
          );
        })
      ) : (
        <p>Nothing to see here yet...</p>
      )}
    </ul>

    <NewsletterSignUpReact client:visible />
  </div>
</Layout>
