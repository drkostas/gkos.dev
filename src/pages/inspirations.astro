---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { GetInTouchReact } from "@/components/GetInTouchReact";
import { ScrapbookBentoReact } from "@/components/ScrapbookBentoReact";
import { CurrentlyReadingBentoReact } from "@/components/CurrentlyReadingBentoReact";
import { CurrentlyPlayingBentoReact } from "@/components/CurrentlyPlayingBentoReact";
import { FavoritePaperBentoReact } from "@/components/FavoritePaperBentoReact";
import { BookshelfBentoReact } from "@/components/BookshelfBentoReact";
import { PeopleGridBentoReact } from "@/components/PeopleGridBentoReact";
import { ResourcesBentoReact } from "@/components/ResourcesBentoReact";
---

<Layout title="Inspirations | Kostas Georgiou">
  <div class="relative">
    <div class="relative space-y-16 md:space-y-20">
      <!-- Hero -->
      <div class="mx-auto text-balance pt-14 md:pt-16">
        <GridWrapper>
          <div class="mb-4 text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
            <span>Inspirations</span>
          </div>
        </GridWrapper>
        <GridWrapper>
          <h1 class="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
            Books, papers, and people that shape my thinking.
          </h1>
        </GridWrapper>
        <GridWrapper>
          <p class="mx-auto mt-6 max-w-2xl text-center leading-8 text-text-secondary">
            A living collection of the things I find myself coming back to.
          </p>
        </GridWrapper>
      </div>

      <!-- Row 1: Favorite Paper + Currently Reading + Spotify -->
      <section>
        <GridWrapper>
          <div class="grid auto-rows-[minmax(320px,auto)] grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-12">
            <div class="md:col-span-1 lg:col-span-5">
              <FavoritePaperBentoReact client:visible />
            </div>
            <div class="md:col-span-1 lg:col-span-4">
              <CurrentlyReadingBentoReact client:visible />
            </div>
            <div class="md:col-span-2 lg:col-span-3">
              <CurrentlyPlayingBentoReact client:visible />
            </div>
          </div>
        </GridWrapper>
      </section>

      <!-- Row 2: Bookshelf + Scrapbook -->
      <section>
        <GridWrapper>
          <div class="grid auto-rows-[minmax(300px,auto)] grid-cols-1 gap-2 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <BookshelfBentoReact client:visible />
            </div>
            <div class="lg:col-span-8">
              <ScrapbookBentoReact client:visible />
            </div>
          </div>
        </GridWrapper>
      </section>

      <!-- Row 3: People + Resources -->
      <section>
        <GridWrapper>
          <div class="grid auto-rows-[minmax(320px,auto)] grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-12">
            <div class="md:col-span-1 lg:col-span-5">
              <PeopleGridBentoReact client:visible />
            </div>
            <div class="md:col-span-1 lg:col-span-7">
              <ResourcesBentoReact client:visible />
            </div>
          </div>
        </GridWrapper>
      </section>

      <GetInTouchReact client:visible />
    </div>
  </div>
</Layout>
