---
import Layout from "@/layouts/Layout.astro";
import GridWrapper from "@/components/GridWrapper.astro";
import { GetInTouchReact } from "@/components/GetInTouchReact";
import { ScrapbookBentoReact } from "@/components/ScrapbookBentoReact";
import { CurrentlyReadingBentoReact } from "@/components/CurrentlyReadingBentoReact";
import { CurrentlyPlayingBentoReact } from "@/components/CurrentlyPlayingBentoReact";
import { inspirations, CATEGORY_LABELS, INSPIRATION_CATEGORIES } from "@/data/inspirations";

// Group by category
const byCategory = INSPIRATION_CATEGORIES.map((cat) => ({
  key: cat,
  label: CATEGORY_LABELS[cat],
  items: inspirations.filter((i) => i.category === cat),
})).filter((g) => g.items.length > 0);

// Accent colors per category — gives each section a distinct feel
const categoryAccents: Record<string, { pill: string; bar: string }> = {
  paper: { pill: "border-indigo-400/50 bg-indigo-50 text-indigo-700 dark:border-indigo-400/30 dark:bg-indigo-500/10 dark:text-indigo-300", bar: "bg-indigo-500" },
  book: { pill: "border-amber-400/50 bg-amber-50 text-amber-700 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-300", bar: "bg-amber-500" },
  person: { pill: "border-emerald-400/50 bg-emerald-50 text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-300", bar: "bg-emerald-500" },
  resource: { pill: "border-purple-400/50 bg-purple-50 text-purple-700 dark:border-purple-400/30 dark:bg-purple-500/10 dark:text-purple-300", bar: "bg-purple-500" },
};
---

<Layout title="Inspirations | Kostas Georgiou">
  <div class="relative">
    <div class="relative space-y-16 md:space-y-20">
      <!-- Hero -->
      <div class="mx-auto text-balance pt-14 md:pt-16">
        <GridWrapper>
          <div class="mb-4 text-center text-xs font-semibold uppercase tracking-widest text-purple-primary">
            <span>Inspirations</span>
          </div>
        </GridWrapper>
        <GridWrapper>
          <h1 class="mx-auto max-w-2xl text-center text-4xl font-medium leading-tight tracking-tighter text-text-primary md:text-6xl md:leading-[64px]">
            Books, papers, and people that shape my thinking.
          </h1>
        </GridWrapper>
        <GridWrapper>
          <p class="mx-auto mt-6 max-w-2xl text-center leading-8 text-text-secondary">
            A living collection of the things I find myself coming back to. The papers I reread, the books I recommend, and the researchers I follow.
          </p>
        </GridWrapper>
      </div>

      <!-- Widgets: Scrapbook + Currently Reading + Recent Favorite -->
      <section>
        <GridWrapper>
          <div class="grid grid-cols-1 gap-2 lg:grid-cols-12">
            <div class="lg:col-span-3 lg:row-span-6">
              <CurrentlyPlayingBentoReact client:visible />
            </div>
            <div class="hidden lg:col-span-9 lg:row-span-5 lg:block">
              <ScrapbookBentoReact client:visible />
            </div>
            <div class="lg:col-span-12 lg:row-span-4">
              <CurrentlyReadingBentoReact client:visible />
            </div>
          </div>
        </GridWrapper>
      </section>

      <!-- Curated inspirations list -->
      {byCategory.map((group) => {
        const accent = categoryAccents[group.key] || categoryAccents.paper;
        return (
          <section>
            <GridWrapper>
              <div class="mb-6 flex items-center gap-3">
                <span
                  class:list={[
                    "inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-widest",
                    accent.pill,
                  ]}
                >
                  {group.label}
                </span>
                <div class="h-px flex-1 bg-border-primary/50"></div>
                <span class="font-mono text-xs text-text-tertiary">{group.items.length}</span>
              </div>
            </GridWrapper>

            <ul class="flex flex-col">
              {group.items.map((item, idx) => (
                <li>
                  <a
                    href={item.link || "#"}
                    target={item.link ? "_blank" : undefined}
                    rel={item.link ? "noopener noreferrer" : undefined}
                    class:list={[
                      "block transition-colors",
                      item.link ? "hover:bg-white/60 cursor-pointer" : "cursor-default",
                    ]}
                    data-umami-event={item.link ? `inspiration-${group.key}-${idx}` : undefined}
                  >
                    <article class="grid h-full grid-cols-1 px-4 md:grid-cols-12">
                      {/* Left: author / meta */}
                      <div class="hidden items-start pt-5 md:col-span-3 md:col-start-1 md:flex lg:col-span-3">
                        <div class="space-y-1">
                          {item.author && (
                            <span class="font-mono text-sm text-text-secondary">{item.author}</span>
                          )}
                        </div>
                      </div>

                      {/* Dashed divider */}
                      <div class="col-start-4 hidden h-full border-x border-border-primary md:block md:border-dashed"></div>

                      {/* Right: content */}
                      <div class="col-span-8 flex w-full flex-grow flex-col py-5 md:col-start-5 md:col-end-12 md:px-4">
                        <h3 class="mb-1 text-base font-medium leading-6 tracking-tight text-text-primary md:text-lg md:leading-tight">
                          {item.title}
                        </h3>
                        {item.author && (
                          <span class="mb-2 inline-block font-mono text-xs text-text-tertiary md:hidden">
                            {item.author}
                          </span>
                        )}
                        <p class="text-sm leading-relaxed text-text-secondary">
                          {item.description}
                        </p>
                        {item.link && (
                          <div class="mt-3 flex items-center text-sm font-medium text-indigo-600 dark:text-indigo-400">
                            <span class="text-sm leading-6">View</span>
                            <svg class="relative ml-2 mt-px overflow-visible transition-transform group-hover:translate-x-0.5" width="3" height="6" viewBox="0 0 3 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M0 0L3 3L0 6"></path></svg>
                          </div>
                        )}
                      </div>
                    </article>
                  </a>
                  <div class="h-0 w-full border-t border-border-primary/50"></div>
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      <GetInTouchReact client:visible />
    </div>
  </div>
</Layout>
