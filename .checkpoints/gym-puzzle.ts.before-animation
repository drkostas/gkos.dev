/**
 * Tiles that BLOCK movement when currently placed on the map.
 * These match the OG "On" variants that have MAPGRID_IMPASSABLE set.
 */
/**
 * Tiles that BLOCK movement — derived EXACTLY from pokeemerald's
 * MauvilleGymSetDefaultBarriers (field_specials.c) and the default-state
 * collision bits in MauvilleCity_Gym map.bin.
 *
 * Rules:
 *   - H1/H2 "On" and "Off": ALWAYS passable (top halves of beams).
 *   - H3/H4 "On": blocking (has MAPGRID_IMPASSABLE in the Off→On toggle).
 *   - H3/H4 "Off": passable.
 *   - GreenV1/V2, RedV1/V2 "On": blocking (vertical beams).
 *   - PoleBottom On/Off: blocking (physical pole base).
 *   - PoleTop_On: blocking. PoleTop_Off: PASSABLE (top of empty pole).
 */
export const GYM_BLOCKING_TILES: Set<number> = new Set([
  36, 37,   // GreenH3_On, GreenH4_On
  38, 39,   // RedH3_On, RedH4_On
  58, 59,   // GreenV1_On, RedV1_On
  60, 61,   // PoleBottom_On, PoleBottom_Off
  65, 66,   // GreenV2_On, RedV2_On
  71,       // PoleTop_On (PoleTop_Off = 72 is passable)
]);

